/**
 * 测试运行页面。
 * 提供一个空白页面作为测试能力的 UI 载体，
 * 测试用例的实际执行由 TestAbility 驱动。
 */
@Entry
@Component
struct Index {
  build() {
    Column() {
      Text('SystemConfig Test Runner')
        .fontSize(20)
        .fontWeight(FontWeight.Medium)
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Center)
  }
