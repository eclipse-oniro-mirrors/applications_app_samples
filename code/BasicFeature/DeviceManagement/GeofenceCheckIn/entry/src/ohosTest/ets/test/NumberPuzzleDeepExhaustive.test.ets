export default function numberPuzzleDeepExhaustiveTest() {
  describe('NumberPuzzleDeepExhaustiveTest', () => {
    beforeAll(() => {
      hilog.info(DOMAIN, SUITE_TAG, '%{public}s', 'NumberPuzzleDeepExhaustiveTest suite start');
    });

    afterAll(() => {
      hilog.info(DOMAIN, SUITE_TAG, '%{public}s', 'NumberPuzzleDeepExhaustiveTest suite end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_NUMDEEP_0100
     * @tc.name      testDivisorSumDeep0001
     * @tc.desc      Verify divisorSum for every value from 1 to 800 against an independent sum.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testDivisorSumDeep0001', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testDivisorSumDeep0001';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      for (let i = 0; i < DIVISOR_DEEP_CASES.length; i++) {
        const row: DivisorDeepCase = DIVISOR_DEEP_CASES[i];
        expect(NumberPuzzleUtil.divisorSum(row.input)).assertEqual(row.expected);
        checked = checked + 1;
      }
      expect(checked).assertEqual(800);
      expect(NumberPuzzleUtil.divisorSum(0)).assertEqual(0);
      expect(NumberPuzzleUtil.divisorSum(1)).assertEqual(0);
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_NUMDEEP_0200
     * @tc.name      testDigitalRootDeep0002
     * @tc.desc      Verify digitalRoot for every value from 0 to 400.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testDigitalRootDeep0002', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testDigitalRootDeep0002';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      for (let i = 0; i < ROOT_DEEP_CASES.length; i++) {
        const row: RootDeepCase = ROOT_DEEP_CASES[i];
        expect(NumberPuzzleUtil.digitalRoot(row.input)).assertEqual(row.expected);
        checked = checked + 1;
      }
      expect(checked).assertEqual(401);
      expect(NumberPuzzleUtil.digitalRoot(-1)).assertEqual(0);
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_NUMDEEP_0300
     * @tc.name      testTriangularDeep0003
     * @tc.desc      Verify isTriangular for every value from 0 to 400.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testTriangularDeep0003', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testTriangularDeep0003';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      let triangularCount: number = 0;
      for (let i = 0; i < TRIANGULAR_DEEP_CASES.length; i++) {
        const row: TriangularDeepCase = TRIANGULAR_DEEP_CASES[i];
        expect(NumberPuzzleUtil.isTriangular(row.input)).assertEqual(row.expected);
        if (row.expected) { triangularCount = triangularCount + 1; }
        checked = checked + 1;
      }
      expect(checked).assertEqual(401);
      expect(triangularCount).assertEqual(28);
      expect(NumberPuzzleUtil.isTriangular(-1)).assertFalse();
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

  });
}
