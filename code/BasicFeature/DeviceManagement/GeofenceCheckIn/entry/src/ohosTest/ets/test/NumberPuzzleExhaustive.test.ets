export default function numberPuzzleExhaustiveTest() {
  describe('NumberPuzzleExhaustiveTest', () => {
    beforeAll(() => {
      hilog.info(DOMAIN, SUITE_TAG, '%{public}s', 'NumberPuzzleExhaustiveTest suite start');
    });

    afterAll(() => {
      hilog.info(DOMAIN, SUITE_TAG, '%{public}s', 'NumberPuzzleExhaustiveTest suite end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_NUMEXH_0100
     * @tc.name      testClassifyExhaustive0001
     * @tc.desc      Verify the perfect, abundant and deficient classification for every value from 1 to 300.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testClassifyExhaustive0001', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testClassifyExhaustive0001';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let perfectCount: number = 0;
      let abundantCount: number = 0;
      let deficientCount: number = 0;
      let checked: number = 0;
      for (let i = 0; i < CLASSIFY_EXHAUSTIVE_CASES.length; i++) {
        const row: ClassifyExhaustiveCase = CLASSIFY_EXHAUSTIVE_CASES[i];
        const actual: string = NumberPuzzleUtil.classifyNumber(row.input);
        expect(actual).assertEqual(row.expected);
        if (actual === 'perfect') { perfectCount = perfectCount + 1; }
        if (actual === 'abundant') { abundantCount = abundantCount + 1; }
        if (actual === 'deficient') { deficientCount = deficientCount + 1; }
        checked = checked + 1;
      }
      expect(checked).assertEqual(300);
      expect(perfectCount).assertEqual(2);
      expect(abundantCount > 0).assertTrue();
      expect(deficientCount > 0).assertTrue();
      expect(perfectCount + abundantCount + deficientCount).assertEqual(300);
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_NUMEXH_0200
     * @tc.name      testDivisorExhaustive0002
     * @tc.desc      Verify the proper divisor sum for every value from 1 to 300.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testDivisorExhaustive0002', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testDivisorExhaustive0002';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      let zeroSums: number = 0;
      for (let i = 0; i < DIVISOR_EXHAUSTIVE_CASES.length; i++) {
        const row: DivisorExhaustiveCase = DIVISOR_EXHAUSTIVE_CASES[i];
        const actual: number = NumberPuzzleUtil.divisorSum(row.input);
        expect(actual).assertEqual(row.expected);
        if (actual === 0) { zeroSums = zeroSums + 1; }
        checked = checked + 1;
      }
      expect(checked).assertEqual(300);
      expect(zeroSums).assertEqual(1);
      expect(NumberPuzzleUtil.divisorSum(220)).assertEqual(284);
      expect(NumberPuzzleUtil.divisorSum(284)).assertEqual(220);
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_NUMEXH_0300
     * @tc.name      testDigitalRootExhaustive0003
     * @tc.desc      Verify the digital root of every value from 0 to 300 matches the repeated digit sum.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testDigitalRootExhaustive0003', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testDigitalRootExhaustive0003';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      for (let i = 0; i < ROOT_EXHAUSTIVE_CASES.length; i++) {
        const row: RootExhaustiveCase = ROOT_EXHAUSTIVE_CASES[i];
        expect(NumberPuzzleUtil.digitalRoot(row.input)).assertEqual(row.expected);
        if (row.input > 0) {
          expect(NumberPuzzleUtil.digitalRoot(row.input)).assertEqual(row.input % 9 === 0 ? 9 : row.input % 9);
        }
        checked = checked + 1;
      }
      expect(checked).assertEqual(301);
      expect(NumberPuzzleUtil.digitalRoot(0)).assertEqual(0);
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_NUMEXH_0400
     * @tc.name      testPowerOfTwoExhaustive0004
     * @tc.desc      Verify the power of two predicate for every value from 1 to 300.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testPowerOfTwoExhaustive0004', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testPowerOfTwoExhaustive0004';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      let matches: number = 0;
      for (let i = 0; i < POWER_EXHAUSTIVE_CASES.length; i++) {
        const row: PowerExhaustiveCase = POWER_EXHAUSTIVE_CASES[i];
        expect(NumberPuzzleUtil.isPowerOfTwo(row.input)).assertEqual(row.expected);
        if (row.expected) { matches = matches + 1; }
        checked = checked + 1;
      }
      expect(checked).assertEqual(300);
      expect(matches).assertEqual(9);
      expect(NumberPuzzleUtil.isPowerOfTwo(256)).assertTrue();
      expect(NumberPuzzleUtil.isPowerOfTwo(255)).assertFalse();
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_NUMEXH_0500
     * @tc.name      testTriangularExhaustive0005
     * @tc.desc      Verify the triangular predicate for every value from 0 to 300.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testTriangularExhaustive0005', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testTriangularExhaustive0005';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      let triangularCount: number = 0;
      for (let i = 0; i < TRI_EXHAUSTIVE_CASES.length; i++) {
        const row: TriExhaustiveCase = TRI_EXHAUSTIVE_CASES[i];
        expect(NumberPuzzleUtil.isTriangular(row.input)).assertEqual(row.expected);
        if (row.expected) { triangularCount = triangularCount + 1; }
        checked = checked + 1;
      }
      expect(checked).assertEqual(301);
      expect(triangularCount).assertEqual(25);
      expect(NumberPuzzleUtil.triangularNumber(24)).assertEqual(300);
      expect(NumberPuzzleUtil.isTriangular(301)).assertFalse();
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

  });
}
