export default function timeDurationDeepExhaustiveTest() {
  describe('TimeDurationDeepExhaustiveTest', () => {
    beforeAll(() => {
      hilog.info(DOMAIN, SUITE_TAG, '%{public}s', 'TimeDurationDeepExhaustiveTest suite start');
    });

    afterAll(() => {
      hilog.info(DOMAIN, SUITE_TAG, '%{public}s', 'TimeDurationDeepExhaustiveTest suite end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_TIMEDEEPDUR_0100
     * @tc.name      testDurationDeep0001
     * @tc.desc      Verify formatDuration for every whole second from 0 to 1500.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testDurationDeep0001', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testDurationDeep0001';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      for (let i = 0; i < DURATION_DEEP_CASES.length; i++) {
        const row: DurationDeepCase = DURATION_DEEP_CASES[i];
        expect(formatDuration(row.input)).assertEqual(row.expected);
        checked = checked + 1;
      }
      expect(checked).assertEqual(1501);
      expect(formatDuration(-1)).assertEqual('00:00:00');
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

  });
}
