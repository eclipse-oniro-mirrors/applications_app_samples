export default function validationDeepExhaustiveTest() {
  describe('ValidationDeepExhaustiveTest', () => {
    beforeAll(() => {
      hilog.info(DOMAIN, SUITE_TAG, '%{public}s', 'ValidationDeepExhaustiveTest suite start');
    });

    afterAll(() => {
      hilog.info(DOMAIN, SUITE_TAG, '%{public}s', 'ValidationDeepExhaustiveTest suite end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_VALDEEP_0100
     * @tc.name      testEmailDeep0001
     * @tc.desc      Verify isValidEmail for one thousand generated addresses.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testEmailDeep0001', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testEmailDeep0001';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      let valid: number = 0;
      for (let i = 0; i < EMAIL_DEEP_CASES.length; i++) {
        const row: EmailDeepCase = EMAIL_DEEP_CASES[i];
        expect(BasicUtil.isValidEmail(row.input)).assertEqual(row.expected);
        if (row.expected) { valid = valid + 1; }
        checked = checked + 1;
      }
      expect(checked).assertEqual(1000);
      expect(valid).assertEqual(500);
      expect(BasicUtil.isValidEmail('')).assertFalse();
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

  });
}
