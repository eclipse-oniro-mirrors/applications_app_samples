     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testGroupThousandsDeep0001', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testGroupThousandsDeep0001';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      for (let i = 0; i < GROUP_DEEP_CASES.length; i++) {
        const row: GroupDeepCase = GROUP_DEEP_CASES[i];
        expect(NumberFormatUtil.groupThousands(row.input)).assertEqual(row.expected);
