export default function geoGridExhaustiveTest() {
  describe('GeoGridExhaustiveTest', () => {
    beforeAll(() => {
      hilog.info(DOMAIN, SUITE_TAG, '%{public}s', 'GeoGridExhaustiveTest suite start');
    });

    afterAll(() => {
      hilog.info(DOMAIN, SUITE_TAG, '%{public}s', 'GeoGridExhaustiveTest suite end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_GEOGEXH_0100
     * @tc.name      testLatitudeIndexExhaustive0001
     * @tc.desc      Verify the latitude grid index and center for every whole degree from -90 to 90.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testLatitudeIndexExhaustive0001', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testLatitudeIndexExhaustive0001';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      for (let i = 0; i < LAT_GRID_CASES.length; i++) {
        const row: LatGridCase = LAT_GRID_CASES[i];
        expect(GeoGridUtil.latitudeIndex(row.input, 1)).assertEqual(row.index);
        expect(Math.abs(GeoGridUtil.centerLatitude(row.index, 1) - row.center) < 0.000001).assertTrue();
        checked = checked + 1;
      }
      expect(checked).assertEqual(181);
      expect(GeoGridUtil.latitudeIndex(-90, 1)).assertEqual(0);
      expect(GeoGridUtil.latitudeIndex(90, 1)).assertEqual(180);
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_GEOGEXH_0200
     * @tc.name      testLongitudeIndexExhaustive0002
     * @tc.desc      Verify the longitude grid index and center for every whole degree from -180 to 180.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testLongitudeIndexExhaustive0002', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testLongitudeIndexExhaustive0002';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      for (let i = 0; i < LON_GRID_CASES.length; i++) {
        const row: LonGridCase = LON_GRID_CASES[i];
        expect(GeoGridUtil.longitudeIndex(row.input, 1)).assertEqual(row.index);
        expect(Math.abs(GeoGridUtil.centerLongitude(row.index, 1) - row.center) < 0.000001).assertTrue();
        checked = checked + 1;
      }
      expect(checked).assertEqual(361);
      expect(GeoGridUtil.longitudeIndex(-180, 1)).assertEqual(0);
      expect(GeoGridUtil.longitudeIndex(180, 1)).assertEqual(360);
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_GEOGEXH_0300
     * @tc.name      testValidityExhaustive0003
     * @tc.desc      Verify coordinate validity for every whole degree inside and outside the ranges.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testValidityExhaustive0003', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testValidityExhaustive0003';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let validLatitudes: number = 0;
      for (let lat = -100; lat <= 100; lat++) {
        const expected: boolean = lat >= -90 && lat <= 90;
        expect(GeoGridUtil.isValidLatitude(lat)).assertEqual(expected);
        if (expected) { validLatitudes = validLatitudes + 1; }
      }
      expect(validLatitudes).assertEqual(181);
      let validLongitudes: number = 0;
      for (let lon = -200; lon <= 200; lon++) {
        const expected: boolean = lon >= -180 && lon <= 180;
        expect(GeoGridUtil.isValidLongitude(lon)).assertEqual(expected);
        if (expected) { validLongitudes = validLongitudes + 1; }
      }
      expect(validLongitudes).assertEqual(361);
      expect(GeoGridUtil.isValidLatitude(NaN)).assertFalse();
      expect(GeoGridUtil.isValidLongitude(Infinity)).assertFalse();
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

  });
}
