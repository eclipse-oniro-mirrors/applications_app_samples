export default function basicUtilStringDeepExhaustiveTest() {
  describe('BasicUtilStringDeepExhaustiveTest', () => {
    beforeAll(() => {
      hilog.info(DOMAIN, SUITE_TAG, '%{public}s', 'BasicUtilStringDeepExhaustiveTest suite start');
    });

    afterAll(() => {
      hilog.info(DOMAIN, SUITE_TAG, '%{public}s', 'BasicUtilStringDeepExhaustiveTest suite end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_BASICDEEP_0100
     * @tc.name      testCapitalizeDeep0001
     * @tc.desc      Verify capitalize for five hundred generated identifiers.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testCapitalizeDeep0001', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testCapitalizeDeep0001';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      for (let i = 0; i < STRING_DEEP_CASES.length; i++) {
        const row: StringDeepCase = STRING_DEEP_CASES[i];
        expect(BasicUtil.capitalize(row.input)).assertEqual(row.capitalized);
        checked = checked + 1;
      }
      expect(checked).assertEqual(500);
      expect(BasicUtil.capitalize('')).assertEqual('');
      expect(BasicUtil.capitalize('a')).assertEqual('A');
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

    /**
     * @tc.number    SUB_GEOFENCECHECKIN_BASICDEEP_0200
     * @tc.name      testReverseStringDeep0002
     * @tc.desc      Verify reverseString for five hundred generated identifiers and its involution.
     * @tc.size      SmallTest
     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testReverseStringDeep0002', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, () => {
      const TAG: string = 'testReverseStringDeep0002';
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' start');
      let checked: number = 0;
      for (let i = 0; i < STRING_DEEP_CASES.length; i++) {
        const row: StringDeepCase = STRING_DEEP_CASES[i];
        expect(BasicUtil.reverseString(row.input)).assertEqual(row.reversed);
        expect(BasicUtil.reverseString(row.reversed)).assertEqual(row.input);
        checked = checked + 1;
      }
      expect(checked).assertEqual(500);
      expect(BasicUtil.reverseString('')).assertEqual('');
      hilog.info(DOMAIN, TAG, '%{public}s', TAG + ' end');
    });

  });
}
