/**
 * IrSendQueue suite: queue state machine checks. Every job is built with empty
 * frame lists, so the inner frame loop never runs and IrTransmitter, the system
 * infrared API and its permission checks are never touched by this suite.
 */

/** Hilog domain reserved for the ircore send queue logic tests. */
const DOMAIN: number = 0xF83E;
/** Prefix added to every case log so the logs can be filtered by suite. */
const SUITE_PREFIX: string = 'MeetingScene_IrSendQueue_';
/** Ticket id prefix generated by the queue. */
const TICKET_PREFIX: string = 'job-';
/** Rejection reason reported while another job is still running. */
const BUSY_REASON: string = 'BUSY';
/** Longer per-step delay used when a job must still be running after enqueue returns. */
const LONG_GAP_MS: number = 80;
/** Progress events emitted per step: PENDING, SENDING and the final state. */
const EVENTS_PER_STEP: number = 3;
/** Step count of the short jobs. */
const SHORT_JOB_STEPS: number = 2;
/** Step count of the long job. */
const LONG_JOB_STEPS: number = 4;
/** Scene run id stamped on scene sourced jobs. */
const SCENE_RUN_ID: string = 'run-1';
/** Device id stamped on every generated step. */
const STEP_DEVICE_ID: string = 'dev-1';
/** Key id stamped on every generated step. */
const STEP_KEY_ID: string = 'key-1';

/** Builds one send step with the given index, delay and an empty frame list. */
function buildStep(index: number, delayMs: number): SendStep {
  const step: SendStep = new SendStep();
  step.index = index;
  step.deviceId = STEP_DEVICE_ID;
  step.keyId = STEP_KEY_ID;
  step.frames = [];
  step.delayMs = delayMs;
  return step;
}

/** Builds a job whose every step carries an empty frame list. */
function buildEmptyJob(source: SendSource, stepCount: number, delayMs: number): SendJob {
  const job: SendJob = new SendJob();
  job.source = source;
  job.sceneRunId = source === SendSource.SCENE ? SCENE_RUN_ID : '';
  for (let i: number = 0; i < stepCount; i++) {
    job.steps.push(buildStep(i, delayMs));
  }
  return job;
}

/** Records every progress snapshot delivered to one listener. */
class ProgressRecorder {
  /** Progress snapshots in delivery order. */
  progresses: SendProgress[] = [];
  /** Ticket ids in delivery order. */
  ticketIds: string[] = [];
  /** Invocation counter, incremented even when the callback throws. */
  calls: number = 0;
  /** When true the callback throws after recording the snapshot. */
  shouldThrow: boolean = false;

  /** Builds a bound listener function that forwards to this recorder. */
  listener(): (ticketId: string, progress: SendProgress) => void {
    const bound: (ticketId: string, progress: SendProgress) => void =
      (ticketId: string, progress: SendProgress): void => {
        this.calls++;
        this.ticketIds.push(ticketId);
        this.progresses.push(progress);
        if (this.shouldThrow) {
          throw new Error('synthetic listener failure');
        }
      };
    return bound;
  }

  /** Returns how many snapshots carry the given lifecycle state. */
  countState(state: SendState): number {
    let count: number = 0;
    for (let i: number = 0; i < this.progresses.length; i++) {
      if (this.progresses[i].state === state) {
        count++;
      }
    }
    return count;
  }

  /** Reports whether every recorded ticket id matches the expected ticket. */
  allTicketsMatch(expected: string): boolean {
    if (this.ticketIds.length === 0) {
      return false;
    }
    for (let i: number = 0; i < this.ticketIds.length; i++) {
      if (this.ticketIds[i] !== expected) {
        return false;
      }
    }
    return true;
  }

  /** Reports whether every recorded snapshot belongs to the given scene run. */
  allSceneIdsMatch(expected: string): boolean {
    if (this.progresses.length === 0) {
      return false;
    }
    for (let i: number = 0; i < this.progresses.length; i++) {
      if (this.progresses[i].sceneRunId !== expected) {
        return false;
      }
    }
    return true;
  }

  /** Counts the snapshots recorded for the given step index. */
  countStep(stepIndex: number): number {
    let count: number = 0;
    for (let i: number = 0; i < this.progresses.length; i++) {
      if (this.progresses[i].stepIndex === stepIndex) {
        count++;
      }
    }
    return count;
  }

  /** Reports whether every recorded snapshot carries the given total step count. */
  totalStepsConstant(expected: number): boolean {
    for (let i: number = 0; i < this.progresses.length; i++) {
      if (this.progresses[i].totalSteps !== expected) {
        return false;
      }
    }
    return true;
  }

  /** Reports whether the terminal event of every recorded step reached the SUCCESS state. */
  allStepsSucceeded(): boolean {
    if (this.progresses.length === 0) {
      return false;
    }
    for (let i: number = EVENTS_PER_STEP - 1; i < this.progresses.length; i += EVENTS_PER_STEP) {
      if (this.progresses[i].state !== SendState.SUCCESS) {
        return false;
      }
    }
    return true;
  }

  /** Reports whether every step triple PENDING, SENDING, SUCCESS appears in order and steps never regress. */
  triplesAreOrdered(): boolean {
    let previousStep: number = -1;
    let phase: number = 0;
    for (let i: number = 0; i < this.progresses.length; i++) {
      const progress: SendProgress = this.progresses[i];
      if (progress.stepIndex < previousStep) {
        return false;
      }
      if (progress.stepIndex !== previousStep) {
        // A new step always restarts the triple with PENDING.
        if (progress.state !== SendState.PENDING) {
          return false;
        }
        previousStep = progress.stepIndex;
        phase = 1;
        continue;
      }
      // Same step: SENDING must follow PENDING, SUCCESS must follow SENDING.
      if (progress.state === SendState.SENDING && phase === 1) {
        phase = 2;
      } else if (progress.state === SendState.SUCCESS && phase === 2) {
        phase = 3;
      } else {
        return false;
      }
    }
    return true;
  }

  /** Returns the last recorded snapshot, or undefined when nothing was recorded. */
  lastSnapshot(): SendProgress | undefined {
    if (this.progresses.length === 0) {
      return undefined;
    }
    return this.progresses[this.progresses.length - 1];
  }

  /** Collects the distinct step indexes in first delivery order. */
  distinctStepIndexes(): number[] {
    const indexes: number[] = [];
    for (let i: number = 0; i < this.progresses.length; i++) {
      const current: number = this.progresses[i].stepIndex;
      if (indexes.indexOf(current) < 0) {
        indexes.push(current);
      }
    }
    return indexes;
  }
}


/** Reports whether two ticket ids differ; a rejected job keeps the empty id and also differs. */
function differentTickets(first: string, second: string): boolean {
  return first !== second;
}

/** Creates an empty progress recorder. */
function buildProgressRecorder(): ProgressRecorder {
  const recorder: ProgressRecorder = new ProgressRecorder();
  return recorder;
}

/** Collects the distinct step indexes seen in the recorded snapshots. */
function distinctStepIndexes(recorder: ProgressRecorder): number[] {
  const indexes: number[] = [];
  for (let i: number = 0; i < recorder.progresses.length; i++) {
    const index: number = recorder.progresses[i].stepIndex;
    if (indexes.indexOf(index) < 0) {
      indexes.push(index);
    }
  }
  return indexes;
}

/** Returns the last recorded snapshot, or undefined for an empty recorder. */
function lastSnapshot(recorder: ProgressRecorder): SendProgress | undefined {
  if (recorder.progresses.length === 0) {
    return undefined;
  }
  return recorder.progresses[recorder.progresses.length - 1];
}

/** Reports whether every step of the job carries an empty frame list. */
function stepsHaveNoFrames(job: SendJob): boolean {
  for (let i: number = 0; i < job.steps.length; i++) {
    if (job.steps[i].frames.length !== 0) {
      return false;
    }
  }
  return true;
}

export default function irSendQueueLogicExtraTest() {
