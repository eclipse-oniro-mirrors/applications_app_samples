     * @tc.type      Function
     * @tc.level     Level 1
     */
    it('testIrSendQueue0001', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, async () => {
      const TAG: string = 'testIrSendQueue0001';
      hilog.info(DOMAIN, TAG, '%{public}s', SUITE_PREFIX + TAG + ' start');
      const queue: IrSendQueue = IrSendQueue.getInstance();
      await queue.waitIdle();
      const again: IrSendQueue = IrSendQueue.getInstance();
      expect(queue === again).assertTrue();
      expect(IrSendQueue.getInstance() === queue).assertTrue();
      expect(queue.isBusy()).assertFalse();
      expect(IrSendQueue.getInstance().isBusy()).assertFalse();
      hilog.info(DOMAIN, TAG, '%{public}s', SUITE_PREFIX + TAG + ' end');
    });

    /**
     * @tc.number    SUB_MEETINGSCENE_LOGIC_IRSENDQUEUE_0101
