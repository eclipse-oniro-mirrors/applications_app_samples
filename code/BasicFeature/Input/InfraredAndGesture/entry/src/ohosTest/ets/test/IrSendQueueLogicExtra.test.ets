    it('testIrSendQueue0002', TestType.FUNCTION | Size.SMALLTEST | Level.LEVEL1, async () => {
      const TAG: string = 'testIrSendQueue0002';
      hilog.info(DOMAIN, TAG, '%{public}s', SUITE_PREFIX + TAG + ' start');
      const queue: IrSendQueue = IrSendQueue.getInstance();
      const job: SendJob = buildEmptyJob(SendSource.MANUAL, 1, 0);
