      const listener: (ticketId: string, progress: SendProgress) => void = recorder.listener();
      queue.onProgress(listener);
      const ticket: SendTicket = queue.enqueue(buildEmptyJob(SendSource.MANUAL, 2, 0));
      expect(ticket.accepted).assertTrue();
      await queue.waitIdle();
      expect(recorder.progresses.length).assertEqual(EVENTS_PER_STEP * 2);
      expect(recorder.progresses[0].stepIndex).assertEqual(0);
      expect(recorder.progresses[EVENTS_PER_STEP].stepIndex).assertEqual(1);
      let monotonic: boolean = true;
      for (let i: number = 1; i < recorder.progresses.length; i++) {
        if (recorder.progresses[i].stepIndex < recorder.progresses[i - 1].stepIndex) {
