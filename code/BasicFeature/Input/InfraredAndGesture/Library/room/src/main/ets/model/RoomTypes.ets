import { AppConstants, StringResources } from 'common';

/**
 * Device categories supported by the meeting room model. The enum value is
 * persisted verbatim in the device table `type` column.
 */
export enum DeviceType {
  /** Projector controlled through HDMI and IR power keys. */
  PROJECTOR = 'PROJECTOR',
  /** Electric projection screen driven by up/down IR keys. */
  SCREEN = 'SCREEN',
  /** Room light with on/off switching only. */
  LIGHT = 'LIGHT',
  /** Air conditioner with temperature and fan-speed keys. */
  AC = 'AC',
  /** Television set with HDMI and volume keys. */
  TV = 'TV',
  /** Audio amplifier with volume keys. */
  AUDIO = 'AUDIO'
}

/**
 * Semantic action a physical remote key represents. The enum value is
 * persisted in the key table `semantic` column and drives expected-state
 * transitions.
 */
export enum KeySemantic {
  /** Switch the device on. */
  POWER_ON = 'POWER_ON',
  /** Switch the device off. */
  POWER_OFF = 'POWER_OFF',
  /** Toggle between on and off states. */
  POWER_TOGGLE = 'POWER_TOGGLE',
  /** Select the first HDMI input. */
  HDMI_1 = 'HDMI_1',
  /** Select the second HDMI input. */
  HDMI_2 = 'HDMI_2',
  /** Increase the volume (or level-based value). */
  VOL_UP = 'VOL_UP',
  /** Decrease the volume (or level-based value). */
  VOL_DOWN = 'VOL_DOWN',
  /** Raise the air conditioner temperature. */
  TEMP_UP = 'TEMP_UP',
  /** Lower the air conditioner temperature. */
  TEMP_DOWN = 'TEMP_DOWN',
  /** Cycle the air conditioner fan speed. */
  FAN_SPEED = 'FAN_SPEED',
  /** Roll the projection screen up. */
  SCREEN_UP = 'SCREEN_UP',
  /** Roll the projection screen down. */
  SCREEN_DOWN = 'SCREEN_DOWN'
}

/** Power state tracked for a device; drives the meeting scene power-on flow. */
export enum PowerState {
  /** No reliable state known yet. */
  UNKNOWN = 'UNKNOWN',
  /** The device is expected to be powered on. */
  ON = 'ON',
  /** The device is expected to be powered off. */
  OFF = 'OFF'
}

/**
 * Where the expected state came from. MANUAL states are never overwritten by
 * scene runs so user corrections stay sticky.
 */
export enum StateSource {
  /** Derived automatically from a scene run. */
  SCENE = 'SCENE',
  /** Set explicitly by the user through a manual correction. */
  MANUAL = 'MANUAL',
  /** Reported by the system (reserved for future integrations). */
  SYSTEM = 'SYSTEM'
}

/** A meeting room, the top-level aggregation root of the data model. */
export class Room {
  /** Primary key, generated by callers as a UUID string. */
  public id: string = '';
  /** Display name, localized for the current locale. */
  public name: string = '';
  /** Optional free-form note shown on the room detail page. */
  public note: string = '';
  /** Sort key used by room list queries. */
  public sortOrder: number = 0;
  /** Row creation time in milliseconds since epoch. */
  public createdAt: number = 0;
  /** Row last-update time in milliseconds since epoch. */
  public updatedAt: number = 0;
}

/** An IR-controlled device placed inside a room. */
export class Device {
  /** Primary key, generated by callers as a UUID string. */
  public id: string = '';
  /** Owning room id; indexed in the database. */
  public roomId: string = '';
  /** Display name, localized for the current locale. */
  public name: string = '';
  /** Device category, one of DeviceType values. */
  public type: DeviceType = DeviceType.PROJECTOR;
  /** Remote template id that defines the default key layout. */
  public templateId: string = '';
  /** Brand used for IR code library matching. */
  public brand: string = '';
  /** Model used for IR code library matching. */
  public model: string = '';
  /** Sort key used by device list queries. */
  public sortOrder: number = 0;
  /** Row creation time in milliseconds since epoch. */
  public createdAt: number = 0;
  /** Row last-update time in milliseconds since epoch. */
  public updatedAt: number = 0;
}

/** A logical remote key bound to a device and optionally to an IR code. */
export class RoomKey {
  /** Primary key, generated by callers as a UUID string. */
  public id: string = '';
  /** Owning device id. */
  public deviceId: string = '';
  /** Semantic action of the key, one of KeySemantic values. */
  public semantic: KeySemantic = KeySemantic.POWER_ON;
  /** Display label, localized for the current locale. */
  public label: string = '';
  /** Referenced IR code id; empty until a code is assigned. */
  public irCodeId: string = '';
  /** Sort key used by key list queries. */
  public sortOrder: number = 0;
}

/** A remote layout template used to seed keys for a device type. */
export class RemoteTemplate {
  /** Primary key; builtin templates use the `tpl-<TYPE>` naming scheme. */
  public id: string = '';
  /** Device category this template applies to. */
  public deviceType: DeviceType = DeviceType.PROJECTOR;
  /** Display name of the template. */
  public name: string = '';
  /** Comma-separated KeySemantic list describing the key layout. */
  public layout: string = '';
  /** True when the template ships with the app and cannot be deleted. */
  public builtin: boolean = false;
}

/** A scene that groups several steps executed in order for one room. */
export class Scene {
  /** Primary key, generated by callers as a UUID string. */
  public id: string = '';
  /** Owning room id; indexed in the database. */
  public roomId: string = '';
  /** Display name, localized for the current locale. */
  public name: string = '';
  /** Icon resource name for the scene card. */
  public icon: string = '';
  /** Sort key used by scene list queries. */
  public sortOrder: number = 0;
}

/** One step of a scene: send a key to a device, then wait before the next step. */
export class SceneStep {
  /** Primary key, generated by callers as a UUID string. */
  public id: string = '';
  /** Owning scene id; indexed together with step_order. */
  public sceneId: string = '';
  /** Target device id to send the key to. */
  public deviceId: string = '';
  /** Key id (RoomKey) executed by this step. */
  public keyId: string = '';
  /** Wait time after execution, in milliseconds. */
  public delayMs: number = AppConstants.STEP_INTERVAL_MS;
  /** Zero-based execution order inside the scene; unique per scene. */
  public order: number = 0;
  /** Disabled steps are skipped by validation and scene runs. */
  public enabled: boolean = true;
}

/** The power/level state a device is expected to be in after scene runs. */
export class DeviceExpectedState {
  /** Primary key; one row per device. */
  public deviceId: string = '';
  /** Expected power state, one of PowerState values. */
  public power: PowerState = PowerState.UNKNOWN;
  /** Expected numeric level (-1 when the device has no level concept). */
  public level: number = -1;
  /** Origin of this state, one of StateSource values. */
  public source: StateSource = StateSource.SCENE;
  /** Row last-update time in milliseconds since epoch. */
  public updatedAt: number = 0;
}

/** One IR transmission record persisted for the history page. */
export class SendLog {
  /** Primary key, generated by callers as a UUID string. */
  public id: string = '';
  /** Transmission time in milliseconds since epoch; indexed. */
  public timestamp: number = 0;
  /** Room id the target device belongs to. */
  public roomId: string = '';
  /** Target device id. */
  public deviceId: string = '';
  /** Executed key id. */
  public keyId: string = '';
  /** Carrier frequency used for the transmission, in hertz. */
  public frequencyHz: number = 0;
  /** Truncated pattern summary for quick debugging. */
  public patternSummary: string = '';
  /** Result code text, e.g. `ok` or a failure reason. */
  public result: string = '';
  /** Total transmission duration in milliseconds. */
  public durationMs: number = 0;
  /** Scene run id when the send was part of a scene; empty otherwise. */
  public sceneRunId: string = '';
}

/** Result of scene validation, listing every broken reference or rule. */
export class SceneValidation {
  /** True when the scene can be executed as-is. */
  public valid: boolean = false;
  /** Device ids referenced by steps but missing from the device table. */
  public missingDeviceIds: string[] = [];
  /** Key ids referenced by steps but missing or mismatched. */
  public missingKeyIds: string[] = [];
  /** True when the enabled step count exceeds the configured limit. */
  public tooManySteps: boolean = false;
  /** Human-readable problems for UI display. */
  public messages: string[] = [];
}

/** Result of a scene run: which steps succeeded and why the run stopped. */
export class SceneRunResult {
  /** True when every enabled step completed successfully. */
  public ok: boolean = false;
  /** Unique id of this run, also written into send_log rows. */
  public runId: string = '';
  /** Short summary of the run outcome. */
  public message: string = '';
  /** Zero-based indexes of steps that failed. */
  public failedStepIndexes: number[] = [];
}

/** Result of exporting a configuration package to a JSON file. */
export class ConfigExportResult {
  /** True when the file was written successfully. */
  public ok: boolean = false;
  /** Absolute path of the written package file. */
  public filePath: string = '';
  /** Number of rooms included in the package. */
  public roomCount: number = 0;
  /** Number of devices included in the package. */
  public deviceCount: number = 0;
  /** Short summary of the export outcome. */
  public message: string = '';
}

/** Result of importing a configuration package or IR code library file. */
export class ConfigImportReport {
  /** True when at least the whole package was imported. */
  public ok: boolean = false;
  /** Number of rooms written during the import. */
  public importedRooms: number = 0;
  /** Number of devices written during the import. */
  public importedDevices: number = 0;
  /** Number of keys written during the import. */
  public importedKeys: number = 0;
  /** Number of scenes written during the import. */
  public importedScenes: number = 0;
  /** Human-readable failure reasons, one entry per rejected item. */
  public failedItems: string[] = [];
  /** Path of the pre-import database backup; empty when not created. */
  public backupPath: string = '';
  /** Short summary of the import outcome. */
  public message: string = '';
}

/** Result of a database schema migration attempt. */
export class MigrationResult {
  /** True when the store version now matches the expected version. */
  public ok: boolean = false;
  /** Version the database had before the migration. */
  public fromVersion: number = 0;
  /** Version the database has after the migration. */
  public toVersion: number = 0;
  /** Path of the pre-migration backup file; empty when not created. */
  public backupPath: string = '';
  /** Short summary of the migration outcome. */
  public message: string = '';
}

/**
 * Resolves a localized string with a non-empty English fallback so the UI
 * never renders an empty label when the resource is missing.
 */
function localized(resource: Resource, fallback: string): string {
  const text: string = StringResources.get(resource);
  return text.length > 0 ? text : fallback;
}

/** Returns the localized display label for a device type. */
export function getDeviceTypeLabel(type: DeviceType): string {
  switch (type) {
    case DeviceType.PROJECTOR:
      return localized($r('app.string.device_type_projector'), 'Projector');
    case DeviceType.SCREEN:
      return localized($r('app.string.device_type_screen'), 'Screen');
    case DeviceType.LIGHT:
      return localized($r('app.string.device_type_light'), 'Light');
    case DeviceType.AC:
      return localized($r('app.string.device_type_ac'), 'Air Conditioner');
    case DeviceType.TV:
      return localized($r('app.string.device_type_tv'), 'TV');
    case DeviceType.AUDIO:
      return localized($r('app.string.device_type_audio'), 'Audio');
    default:
      return localized($r('app.string.device_type_unknown'), 'Device');
  }
}

/** Returns the localized display label for a key semantic. */
export function getKeySemanticLabel(semantic: KeySemantic): string {
  switch (semantic) {
    case KeySemantic.POWER_ON:
      return localized($r('app.string.key_semantic_power_on'), 'Power On');
    case KeySemantic.POWER_OFF:
      return localized($r('app.string.key_semantic_power_off'), 'Power Off');
    case KeySemantic.POWER_TOGGLE:
      return localized($r('app.string.key_semantic_power_toggle'), 'Power Toggle');
    case KeySemantic.HDMI_1:
      return localized($r('app.string.key_semantic_hdmi_1'), 'HDMI1');
    case KeySemantic.HDMI_2:
      return localized($r('app.string.key_semantic_hdmi_2'), 'HDMI2');
    case KeySemantic.VOL_UP:
      return localized($r('app.string.key_semantic_volume_up'), 'Volume Up');
    case KeySemantic.VOL_DOWN:
      return localized($r('app.string.key_semantic_volume_down'), 'Volume Down');
    case KeySemantic.TEMP_UP:
      return localized($r('app.string.key_semantic_temperature_up'), 'Temperature Up');
    case KeySemantic.TEMP_DOWN:
      return localized($r('app.string.key_semantic_temperature_down'), 'Temperature Down');
    case KeySemantic.FAN_SPEED:
      return localized($r('app.string.key_semantic_fan_speed'), 'Fan Speed');
    case KeySemantic.SCREEN_UP:
      return localized($r('app.string.key_semantic_screen_up'), 'Screen Up');
    case KeySemantic.SCREEN_DOWN:
      return localized($r('app.string.key_semantic_screen_down'), 'Screen Down');
    default:
      return localized($r('app.string.key_semantic_unknown'), 'Key');
  }
}
