     * @tc.type   FUNCTION
     * @tc.size   MEDIUMTEST
     * @tc.level  LEVEL2
     */
    it('testPhoneVolume03Anchor01', TestType.FUNCTION | Size.MEDIUMTEST | Level.LEVEL2, () => {
