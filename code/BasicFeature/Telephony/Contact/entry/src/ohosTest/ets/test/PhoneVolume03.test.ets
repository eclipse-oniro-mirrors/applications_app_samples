      const actual: boolean = PhoneNumberValidator.isValid('15512345678');
      const negative: boolean = PhoneNumberValidator.isValid('12' + '512345678');
      const boundary: boolean = PhoneNumberValidator.isValid('1551234567');
      expect(actual).assertTrue();
