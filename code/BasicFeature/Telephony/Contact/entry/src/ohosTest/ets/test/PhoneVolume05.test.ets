     * @tc.type   FUNCTION
     * @tc.size   MEDIUMTEST
     * @tc.level  LEVEL2
     */
    it('testPhoneVolume05Anchor01', TestType.FUNCTION | Size.MEDIUMTEST | Level.LEVEL2, () => {
      hilog.info(LOG_DOMAIN, LOG_TAG, '%{public}s', 'testPhoneVolume05Anchor01 begin');
      const actual: boolean = PhoneNumberValidator.isValid('17712345678');
      const negative: boolean = PhoneNumberValidator.isValid('12' + '712345678');
      const boundary: boolean = PhoneNumberValidator.isValid('1771234567');
      expect(actual).assertTrue();
