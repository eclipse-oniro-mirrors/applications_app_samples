/** Resource names and English fallbacks; no locale is resolved at module load. */
export class MessageEntry {
  public id: string;
  public resourceName: string;
  public fallback: string;
  constructor(id: string, resourceName: string, fallback: string) {
    this.id = id;
    this.resourceName = resourceName;
    this.fallback = fallback;
  }
}

/** Source templates describe historical serialized prose. They are not translated model values. */
export class LegacyMessage {
  public id: string;
  public source: string;
  public opaque: number[];
  public pattern: RegExp | undefined = undefined;
  constructor(id: string, source: string, opaque: number[] = []) {
    this.id = id;
    this.source = source;
    this.opaque = opaque;
    if (/\{[0-9]+\}/.test(source)) {
      const parts: string[] = source.split(/\{[0-9]+\}/);
      const escaped: string[] = parts.map((part: string): string => part.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
      this.pattern = new RegExp(`^${escaped.join('([\\s\\S]*?)')}$`);
    }
  }
}

