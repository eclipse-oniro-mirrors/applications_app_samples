/** Pure synchronous model formatting only; never hold this global scope across await/UI work. */
export function withTestMessages<T>(language: string, read: () => T): T {
  return withTextResourceResolver(new TestMessageResolver(language), read);
}

export class TestMessageResolver implements TextResourceResolver {
  private readonly language: string;

  constructor(language: string = 'zh_CN') {
    this.language = language;
  }

  resolve(resourceName: string): string {
    if (this.language === 'zh_CN' && typeof ZH_TEST_MESSAGES[resourceName] === 'string') {
      return ZH_TEST_MESSAGES[resourceName];
    }
    const entry: MessageEntry | undefined = MESSAGE_CATALOG.find((item: MessageEntry): boolean =>
      item.resourceName === resourceName);
    if (entry === undefined) { throw new Error('Unknown test resource name'); }
    return entry.fallback;
  }
}
