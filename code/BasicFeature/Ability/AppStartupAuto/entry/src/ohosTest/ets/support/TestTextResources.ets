/** Pin existing text assertions independently of the device language. */
export function configureTestText(): void {
  setTextResolver((key: string): string => {
    const value = TEST_TEXT.get(key);
    if (value === undefined) { throw new Error(`Missing test resource: ${key}`); }
    return value;
  });
}
