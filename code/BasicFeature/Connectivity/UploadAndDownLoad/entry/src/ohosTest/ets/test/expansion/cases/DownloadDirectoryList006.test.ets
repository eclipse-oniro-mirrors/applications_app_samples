import { expect } from '@ohos/hypium';
import { fileUtils } from '@ohos/uploaddownload';
import fs from '@ohos.file.fs';
import { FileSandbox } from '../fixtures/FileSandbox';
import { finishCleanup } from '../fixtures/CleanupFailure';

/**
 * @tc.number EXP_FILES_LIST_006
 * @tc.name EXP_FILES_LIST_006
 * @tc.desc 空单多文件、Unicode和缺失目录 — FILES_LIST_006. Calls the real production export.
 * @tc.level Level 1
 */
const runExpansionCase: () => Promise<void> = async (): Promise<void> => {
    const sandbox = new FileSandbox('FILES_LIST_006');
    let primaryFailed = true;
    try {
      sandbox.mkdir('Others');
      sandbox.mkdir('Others/child-directory');
      const result = await fileUtils.listFiles(sandbox.root, 'Others');
      expect(result.sort()).assertDeepEquals(['child-directory']);
      primaryFailed = false;
    } finally {
      finishCleanup(primaryFailed, (): void => {
        sandbox.dispose();
      });
    }
  };

export default runExpansionCase;
