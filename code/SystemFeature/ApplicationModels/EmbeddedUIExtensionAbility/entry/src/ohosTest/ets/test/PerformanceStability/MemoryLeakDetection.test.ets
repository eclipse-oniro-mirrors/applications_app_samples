export default function memoryLeakDetectionTest() {
  describe('MemoryLeakDetection_Test', () => {

    beforeAll(() => {
      hilog.info(0xFF00, 'EmbeddedTest', '%{public}s', 'MemoryLeakDetection_Test starting');
    });

    afterAll(() => {
      hilog.info(0xFF00, 'EmbeddedTest', '%{public}s', 'MemoryLeakDetection_Test finished');
    });

    it('memory_leak_detection_focus_path_1', 0, () => {
      const path = new FocusPathModel();
      path.append(0);
      path.append(1 % 3 + 1);
      path.append(1 % 3 + 2);
      expect(path.length()).assertEqual(3);
      expect(path.first()).assertEqual(0);
      expect(path.last()).assertLargerOrEqual(0);
      path.reset();
    });

    it('memory_leak_detection_retry_policy_2', 0, () => {
      const policy = new RetryPolicy(3);
      expect(policy.shouldRetry(1)).assertTrue();
      expect(policy.shouldRetry(3)).assertTrue();
      expect(policy.shouldRetry(4)).assertFalse();
    });

    it('memory_leak_detection_bounded_queue_3', 0, () => {
      const queue = new BoundedQueue(4);
      expect(queue.capacity()).assertEqual(4);
      for (let i = 0; i < 6; i++) {
        queue.push(i);
      }
      expect(queue.size()).assertEqual(4);
      expect(queue.isFull()).assertTrue();
      const first = queue.pop();
      queue.clear();
    });

    it('memory_leak_detection_key_sequence_4', 0, () => {
      const sequence = new KeySequence();
      sequence.append(2015);
      sequence.append(2049);
      sequence.append(2);
      expect(sequence.count()).assertEqual(3);
      expect(sequence.contains(2049)).assertTrue();
      expect(sequence.last()).assertEqual(2);
      sequence.clear();
    });

    it('memory_leak_detection_ui_snapshot_5', 0, () => {
      const first = new UiSnapshotModel().capture(5 % 5 + 1, 5 % 4 + 1, 0);
      const second = new UiSnapshotModel().capture(5 % 5 + 2, 5 % 4 + 1, 1);
      expect(first.getComponentCount()).assertLarger(0);
      expect(first.getTextCount()).assertLarger(0);
      expect(first.getFocusIndex()).assertEqual(0);
    });

    it('memory_leak_detection_resource_ledger_6', 0, () => {
      const ledger = new ResourceLedger();
      ledger.acquire('session-6');
      ledger.acquire('window-6');
      expect(ledger.activeCount()).assertEqual(2);
      expect(ledger.totalAcquired()).assertEqual(2);
      expect(ledger.release('session-6')).assertTrue();
      ledger.reset();
    });

  });
}


class EuiM38_1 {
  public static describe(): string {
    return 'MemoryLeakDetection_Test_pad_1';
  }

  public static checksum(values: number[]): number {
    let total: number = 0;
    for (let i = 0; i < values.length; i++) {
      total = (total + values[i]) % 1000003;
    }
    return total;
  }

  public static clamp(value: number, min: number, max: number): number {
    if (value < min) {
      return min;
    }
    if (value > max) {
      return max;
    }
    return value;
  }

  public static normalize(value: string): string {
    let result: string = '';
    for (let i = 0; i < value.length; i++) {
      if (value.charCodeAt(i) !== 32) {
        result += value.charAt(i);
      }
    }
    return result;
  }

  public static containsValue(values: string[], target: string): boolean {
    for (let i = 0; i < values.length; i++) {
      if (values[i] === target) {
        return true;
      }
    }
    return false;
  }

  public static score(passed: number, failed: number): number {
    const total: number = passed + failed;
    if (total === 0) {
      return 100;
    }
    return Math.round((passed / total) * 100);
  }
}

