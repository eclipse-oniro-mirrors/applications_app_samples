import { describe, it, expect, beforeAll, afterAll } from '@ohos/hypium';
import hilog from '@ohos.hilog';
import {
  LifecycleStateMachine,
  SessionRegistry,
  ConfigProfile,
  TimingMeter,
  EventJournal,
  PayloadCodec,
  HealthProbe,
  ValueValidator,
  ExtensionConstants,
  FocusPathModel,
  RetryPolicy,
  BoundedQueue,
  KeySequence,
  UiSnapshotModel,
  ResourceLedger,
  ExtensionDescriptor,
  ExtensionDescriptorRegistry,
  ExtensionSummary,
  ExtensionSummaryBuilder,
  PayloadShape,
  SessionRecord,
  ConfigEntry,
  TimingSample,
  JournalEntry,
  ProbeResult,
  SnapshotResult
} from './Shared/EmbeddedModels';

export default function abilityTest() {
  describe('EmbeddedAbility_Test', () => {

    beforeAll(() => {
      hilog.info(0xFF00, 'EmbeddedTest', '%{public}s', 'EmbeddedAbility_Test starting');
    });

    afterAll(() => {
      hilog.info(0xFF00, 'EmbeddedTest', '%{public}s', 'EmbeddedAbility_Test finished');
    });

    it('embedded_ability_common_event_1', 0, () => {
      const journal = new EventJournal();
      journal.append('subscribe', ExtensionConstants.PAGE_SHOW_EVENT);
      journal.append('publish', ExtensionConstants.PAGE_SHOW_EVENT);
      expect(journal.contains('publish')).assertTrue();
      expect(journal.count()).assertEqual(2);
      journal.append('delivered', ExtensionConstants.PAGE_SHOW_EVENT);
      expect(journal.count()).assertEqual(3);
    });

    it('embedded_ability_lifecycle_state_2', 0, () => {
      const machine = new LifecycleStateMachine();
      expect(machine.current()).assertEqual('idle');
      expect(machine.transition('onCreate')).assertTrue();
      expect(machine.transition('onForeground')).assertTrue();
      const snapshot = machine.snapshot();
    });

  });
}

