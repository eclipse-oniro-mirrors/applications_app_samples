export default function shareInputInteractionTest() {
  describe('ShareInputInteraction_Test', () => {

    it('shareInputInteractionTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new ShareInputInteractionRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: ShareInputInteractionKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('shareInputInteractionTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new ShareInputInteractionMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('shareInputInteractionTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new ShareInputInteractionValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('shareInputInteractionTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new ShareInputInteractionStateMachine();
      machine.transition(ShareInputInteractionState.READY);
      machine.transition(ShareInputInteractionState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(ShareInputInteractionState.RUNNING);
      machine.transition(ShareInputInteractionState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
