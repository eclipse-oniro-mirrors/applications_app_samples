export default function dialogStateManagementTest() {
  describe('DialogStateManagement_Test', () => {

    it('dialogStateManagementTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new DialogStateManagementRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: DialogStateManagementKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('dialogStateManagementTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new DialogStateManagementMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('dialogStateManagementTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new DialogStateManagementValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('dialogStateManagementTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new DialogStateManagementStateMachine();
      machine.transition(DialogStateManagementState.READY);
      machine.transition(DialogStateManagementState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(DialogStateManagementState.RUNNING);
      machine.transition(DialogStateManagementState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
