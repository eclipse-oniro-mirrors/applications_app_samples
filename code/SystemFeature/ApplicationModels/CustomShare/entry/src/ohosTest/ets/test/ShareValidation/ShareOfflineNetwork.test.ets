export default function shareOfflineNetworkTest() {
  describe('ShareOfflineNetwork_Test', () => {

    it('shareOfflineNetworkTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new ShareOfflineNetworkRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: ShareOfflineNetworkKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('shareOfflineNetworkTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new ShareOfflineNetworkMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('shareOfflineNetworkTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new ShareOfflineNetworkValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('shareOfflineNetworkTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new ShareOfflineNetworkStateMachine();
      machine.transition(ShareOfflineNetworkState.READY);
      machine.transition(ShareOfflineNetworkState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(ShareOfflineNetworkState.RUNNING);
      machine.transition(ShareOfflineNetworkState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
