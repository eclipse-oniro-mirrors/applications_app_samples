import { describe, it, expect } from '@ohos/hypium';
import { TIMEOUT_DIALOG_RENDER, yieldTick } from '../Shared/CustomShareDriver';
enum BoundaryErrorTestingKind {
  LINK = 'link',
  FILE = 'file',
  OTHER = 'other',
  TEXT = 'text',
  EDIT = 'edit'
}

interface BoundaryErrorTestingEntry {
  id: number;
  label: string;
  kind: BoundaryErrorTestingKind;
  enabled: boolean;
}

class BoundaryErrorTestingRegistry {
  private entries: Map<number, BoundaryErrorTestingEntry> = new Map<number, BoundaryErrorTestingEntry>();

  public register(entry: BoundaryErrorTestingEntry): boolean {
    if (entry.id < 0 || entry.label.length === 0) {
      return false;
    }
    this.entries.set(entry.id, entry);
    return true;
  }

  public contains(id: number): boolean {
    return this.entries.has(id);
  }

  public size(): number {
    return this.entries.size;
  }

  public enabledCount(): number {
    let count: number = 0;
    this.entries.forEach((entry: BoundaryErrorTestingEntry) => {
      if (entry.enabled) {
        count++;
      }
    });
    return count;
  }
}
class BoundaryErrorTestingMetrics {
  private counts: Map<string, number> = new Map<string, number>();
  private totalAmount: number = 0;

  public record(key: string, amount: number = 1): void {
    const current: number = this.counts.get(key) ?? 0;
    this.counts.set(key, current + amount);
    this.totalAmount += amount;
  }

  public count(key: string): number {
    return this.counts.get(key) ?? 0;
  }

  public total(): number {
    return this.totalAmount;
  }

  public distinct(): number {
    return this.counts.size;
  }

  public average(): number {
    if (this.counts.size === 0) {
      return 0;
    }
    return this.totalAmount / this.counts.size;
  }
}
enum BoundaryErrorTestingErrorCode {
  OK = 0,
  EMPTY = 1,
  TOO_LONG = 2,
  INVALID = 3
}

interface BoundaryErrorTestingValidationResult {
  ok: boolean;
  code: BoundaryErrorTestingErrorCode;
  message: string;
}

class BoundaryErrorTestingValidator {
  private maxLength: number;

  constructor(maxLength: number = 64) {
    this.maxLength = maxLength;
  }

  public validate(value: string): BoundaryErrorTestingValidationResult {
    if (value.length === 0) {
      return { ok: false, code: BoundaryErrorTestingErrorCode.EMPTY, message: 'empty value' };
    }
    if (value.length > this.maxLength) {
      return { ok: false, code: BoundaryErrorTestingErrorCode.TOO_LONG, message: 'value too long' };
    }
    return { ok: true, code: BoundaryErrorTestingErrorCode.OK, message: 'valid value' };
  }

  public isUrl(value: string): boolean {
    return value.indexOf('http://') === 0 || value.indexOf('https://') === 0;
  }

  public isEmpty(value: string): boolean {
    return value.length === 0;
  }
}
enum BoundaryErrorTestingState {
  IDLE = 'idle',
  READY = 'ready',
  RUNNING = 'running',
  DONE = 'done',
  FAILED = 'failed'
}

class BoundaryErrorTestingStateMachine {
  private state: BoundaryErrorTestingState = BoundaryErrorTestingState.IDLE;
  private transitionCount: number = 0;

  public transition(to: BoundaryErrorTestingState): boolean {
    this.state = to;
    this.transitionCount++;
    return true;
  }

  public current(): BoundaryErrorTestingState {
    return this.state;
  }

  public count(): number {
    return this.transitionCount;
  }

  public isTerminal(): boolean {
    return this.state === BoundaryErrorTestingState.DONE || this.state === BoundaryErrorTestingState.FAILED;
  }

  public reset(): void {
    this.state = BoundaryErrorTestingState.IDLE;
    this.transitionCount = 0;
  }
}
