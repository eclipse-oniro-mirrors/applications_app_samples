export default function boundaryErrorTestingTest() {
  describe('BoundaryErrorTesting_Test', () => {

    it('boundaryErrorTestingTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new BoundaryErrorTestingRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: BoundaryErrorTestingKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('boundaryErrorTestingTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new BoundaryErrorTestingMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('boundaryErrorTestingTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new BoundaryErrorTestingValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('boundaryErrorTestingTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new BoundaryErrorTestingStateMachine();
      machine.transition(BoundaryErrorTestingState.READY);
      machine.transition(BoundaryErrorTestingState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(BoundaryErrorTestingState.RUNNING);
      machine.transition(BoundaryErrorTestingState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
