export default function configurationChangesTest() {
  describe('ConfigurationChanges_Test', () => {

    it('configurationChangesTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new ConfigurationChangesRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: ConfigurationChangesKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('configurationChangesTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new ConfigurationChangesMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('configurationChangesTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new ConfigurationChangesValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('configurationChangesTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new ConfigurationChangesStateMachine();
      machine.transition(ConfigurationChangesState.READY);
      machine.transition(ConfigurationChangesState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(ConfigurationChangesState.RUNNING);
      machine.transition(ConfigurationChangesState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
