import { describe, it, expect } from '@ohos/hypium';
import { TIMEOUT_DIALOG_RENDER, yieldTick } from '../Shared/CustomShareDriver';
enum ConfigurationChangesKind {
  LINK = 'link',
  FILE = 'file',
  OTHER = 'other',
  TEXT = 'text',
  EDIT = 'edit'
}

interface ConfigurationChangesEntry {
  id: number;
  label: string;
  kind: ConfigurationChangesKind;
  enabled: boolean;
}

class ConfigurationChangesRegistry {
  private entries: Map<number, ConfigurationChangesEntry> = new Map<number, ConfigurationChangesEntry>();

  public register(entry: ConfigurationChangesEntry): boolean {
    if (entry.id < 0 || entry.label.length === 0) {
      return false;
    }
    this.entries.set(entry.id, entry);
    return true;
  }

  public contains(id: number): boolean {
    return this.entries.has(id);
  }

  public size(): number {
    return this.entries.size;
  }

  public enabledCount(): number {
    let count: number = 0;
    this.entries.forEach((entry: ConfigurationChangesEntry) => {
      if (entry.enabled) {
        count++;
      }
    });
    return count;
  }
}
class ConfigurationChangesMetrics {
  private counts: Map<string, number> = new Map<string, number>();
  private totalAmount: number = 0;

  public record(key: string, amount: number = 1): void {
    const current: number = this.counts.get(key) ?? 0;
    this.counts.set(key, current + amount);
    this.totalAmount += amount;
  }

  public count(key: string): number {
    return this.counts.get(key) ?? 0;
  }

  public total(): number {
    return this.totalAmount;
  }

  public distinct(): number {
    return this.counts.size;
  }

  public average(): number {
    if (this.counts.size === 0) {
      return 0;
    }
    return this.totalAmount / this.counts.size;
  }
}
enum ConfigurationChangesErrorCode {
  OK = 0,
  EMPTY = 1,
  TOO_LONG = 2,
  INVALID = 3
}

interface ConfigurationChangesValidationResult {
  ok: boolean;
  code: ConfigurationChangesErrorCode;
  message: string;
}

class ConfigurationChangesValidator {
  private maxLength: number;

  constructor(maxLength: number = 64) {
    this.maxLength = maxLength;
  }

  public validate(value: string): ConfigurationChangesValidationResult {
    if (value.length === 0) {
      return { ok: false, code: ConfigurationChangesErrorCode.EMPTY, message: 'empty value' };
    }
    if (value.length > this.maxLength) {
      return { ok: false, code: ConfigurationChangesErrorCode.TOO_LONG, message: 'value too long' };
    }
    return { ok: true, code: ConfigurationChangesErrorCode.OK, message: 'valid value' };
  }

  public isUrl(value: string): boolean {
    return value.indexOf('http://') === 0 || value.indexOf('https://') === 0;
  }

  public isEmpty(value: string): boolean {
    return value.length === 0;
  }
}
enum ConfigurationChangesState {
  IDLE = 'idle',
  READY = 'ready',
  RUNNING = 'running',
  DONE = 'done',
  FAILED = 'failed'
}

class ConfigurationChangesStateMachine {
  private state: ConfigurationChangesState = ConfigurationChangesState.IDLE;
  private transitionCount: number = 0;

  public transition(to: ConfigurationChangesState): boolean {
    this.state = to;
    this.transitionCount++;
    return true;
  }

  public current(): ConfigurationChangesState {
    return this.state;
  }

  public count(): number {
    return this.transitionCount;
  }

  public isTerminal(): boolean {
    return this.state === ConfigurationChangesState.DONE || this.state === ConfigurationChangesState.FAILED;
  }

  public reset(): void {
    this.state = ConfigurationChangesState.IDLE;
    this.transitionCount = 0;
  }
}
