export default function errorRecoveryTest() {
  describe('ErrorRecovery_Test', () => {

    it('errorRecoveryTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new ErrorRecoveryRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: ErrorRecoveryKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('errorRecoveryTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new ErrorRecoveryMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('errorRecoveryTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new ErrorRecoveryValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('errorRecoveryTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new ErrorRecoveryStateMachine();
      machine.transition(ErrorRecoveryState.READY);
      machine.transition(ErrorRecoveryState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(ErrorRecoveryState.RUNNING);
      machine.transition(ErrorRecoveryState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
