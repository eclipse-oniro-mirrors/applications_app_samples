export default function shareAppVersionTest() {
  describe('ShareAppVersion_Test', () => {

    it('shareAppVersionTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new ShareAppVersionRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: ShareAppVersionKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('shareAppVersionTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new ShareAppVersionMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('shareAppVersionTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new ShareAppVersionValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('shareAppVersionTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new ShareAppVersionStateMachine();
      machine.transition(ShareAppVersionState.READY);
      machine.transition(ShareAppVersionState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(ShareAppVersionState.RUNNING);
      machine.transition(ShareAppVersionState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
