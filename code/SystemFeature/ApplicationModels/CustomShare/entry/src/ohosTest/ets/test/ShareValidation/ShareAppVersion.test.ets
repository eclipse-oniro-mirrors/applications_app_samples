import { describe, it, expect } from '@ohos/hypium';
import { TIMEOUT_DIALOG_RENDER, yieldTick } from '../Shared/CustomShareDriver';
enum ShareAppVersionKind {
  LINK = 'link',
  FILE = 'file',
  OTHER = 'other',
  TEXT = 'text',
  EDIT = 'edit'
}

interface ShareAppVersionEntry {
  id: number;
  label: string;
  kind: ShareAppVersionKind;
  enabled: boolean;
}

class ShareAppVersionRegistry {
  private entries: Map<number, ShareAppVersionEntry> = new Map<number, ShareAppVersionEntry>();

  public register(entry: ShareAppVersionEntry): boolean {
    if (entry.id < 0 || entry.label.length === 0) {
      return false;
    }
    this.entries.set(entry.id, entry);
    return true;
  }

  public contains(id: number): boolean {
    return this.entries.has(id);
  }

  public size(): number {
    return this.entries.size;
  }

  public enabledCount(): number {
    let count: number = 0;
    this.entries.forEach((entry: ShareAppVersionEntry) => {
      if (entry.enabled) {
        count++;
      }
    });
    return count;
  }
}
class ShareAppVersionMetrics {
  private counts: Map<string, number> = new Map<string, number>();
  private totalAmount: number = 0;

  public record(key: string, amount: number = 1): void {
    const current: number = this.counts.get(key) ?? 0;
    this.counts.set(key, current + amount);
    this.totalAmount += amount;
  }

  public count(key: string): number {
    return this.counts.get(key) ?? 0;
  }

  public total(): number {
    return this.totalAmount;
  }

  public distinct(): number {
    return this.counts.size;
  }

  public average(): number {
    if (this.counts.size === 0) {
      return 0;
    }
    return this.totalAmount / this.counts.size;
  }
}
enum ShareAppVersionErrorCode {
  OK = 0,
  EMPTY = 1,
  TOO_LONG = 2,
  INVALID = 3
}

interface ShareAppVersionValidationResult {
  ok: boolean;
  code: ShareAppVersionErrorCode;
  message: string;
}

class ShareAppVersionValidator {
  private maxLength: number;

  constructor(maxLength: number = 64) {
    this.maxLength = maxLength;
  }

  public validate(value: string): ShareAppVersionValidationResult {
    if (value.length === 0) {
      return { ok: false, code: ShareAppVersionErrorCode.EMPTY, message: 'empty value' };
    }
    if (value.length > this.maxLength) {
      return { ok: false, code: ShareAppVersionErrorCode.TOO_LONG, message: 'value too long' };
    }
    return { ok: true, code: ShareAppVersionErrorCode.OK, message: 'valid value' };
  }

  public isUrl(value: string): boolean {
    return value.indexOf('http://') === 0 || value.indexOf('https://') === 0;
  }

  public isEmpty(value: string): boolean {
    return value.length === 0;
  }
}
enum ShareAppVersionState {
  IDLE = 'idle',
  READY = 'ready',
  RUNNING = 'running',
  DONE = 'done',
  FAILED = 'failed'
}

class ShareAppVersionStateMachine {
  private state: ShareAppVersionState = ShareAppVersionState.IDLE;
  private transitionCount: number = 0;

  public transition(to: ShareAppVersionState): boolean {
    this.state = to;
    this.transitionCount++;
    return true;
  }

  public current(): ShareAppVersionState {
    return this.state;
  }

  public count(): number {
    return this.transitionCount;
  }

  public isTerminal(): boolean {
    return this.state === ShareAppVersionState.DONE || this.state === ShareAppVersionState.FAILED;
  }

  public reset(): void {
    this.state = ShareAppVersionState.IDLE;
    this.transitionCount = 0;
  }
}
