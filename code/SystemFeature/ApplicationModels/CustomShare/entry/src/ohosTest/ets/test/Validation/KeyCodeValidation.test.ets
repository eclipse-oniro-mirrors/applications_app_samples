import { describe, it, expect } from '@ohos/hypium';
import { TIMEOUT_DIALOG_RENDER, yieldTick } from '../Shared/CustomShareDriver';
enum KeyCodeValidationKind {
  LINK = 'link',
  FILE = 'file',
  OTHER = 'other',
  TEXT = 'text',
  EDIT = 'edit'
}

interface KeyCodeValidationEntry {
  id: number;
  label: string;
  kind: KeyCodeValidationKind;
  enabled: boolean;
}

class KeyCodeValidationRegistry {
  private entries: Map<number, KeyCodeValidationEntry> = new Map<number, KeyCodeValidationEntry>();

  public register(entry: KeyCodeValidationEntry): boolean {
    if (entry.id < 0 || entry.label.length === 0) {
      return false;
    }
    this.entries.set(entry.id, entry);
    return true;
  }

  public contains(id: number): boolean {
    return this.entries.has(id);
  }

  public size(): number {
    return this.entries.size;
  }

  public enabledCount(): number {
    let count: number = 0;
    this.entries.forEach((entry: KeyCodeValidationEntry) => {
      if (entry.enabled) {
        count++;
      }
    });
    return count;
  }
}
class KeyCodeValidationMetrics {
  private counts: Map<string, number> = new Map<string, number>();
  private totalAmount: number = 0;

  public record(key: string, amount: number = 1): void {
    const current: number = this.counts.get(key) ?? 0;
    this.counts.set(key, current + amount);
    this.totalAmount += amount;
  }

  public count(key: string): number {
    return this.counts.get(key) ?? 0;
  }

  public total(): number {
    return this.totalAmount;
  }

  public distinct(): number {
    return this.counts.size;
  }

  public average(): number {
    if (this.counts.size === 0) {
      return 0;
    }
    return this.totalAmount / this.counts.size;
  }
}
enum KeyCodeValidationErrorCode {
  OK = 0,
  EMPTY = 1,
  TOO_LONG = 2,
  INVALID = 3
}

interface KeyCodeValidationValidationResult {
  ok: boolean;
  code: KeyCodeValidationErrorCode;
  message: string;
}

class KeyCodeValidationValidator {
  private maxLength: number;

  constructor(maxLength: number = 64) {
    this.maxLength = maxLength;
  }

  public validate(value: string): KeyCodeValidationValidationResult {
    if (value.length === 0) {
      return { ok: false, code: KeyCodeValidationErrorCode.EMPTY, message: 'empty value' };
    }
    if (value.length > this.maxLength) {
      return { ok: false, code: KeyCodeValidationErrorCode.TOO_LONG, message: 'value too long' };
    }
    return { ok: true, code: KeyCodeValidationErrorCode.OK, message: 'valid value' };
  }

  public isUrl(value: string): boolean {
    return value.indexOf('http://') === 0 || value.indexOf('https://') === 0;
  }

  public isEmpty(value: string): boolean {
    return value.length === 0;
  }
}
enum KeyCodeValidationState {
  IDLE = 'idle',
  READY = 'ready',
  RUNNING = 'running',
  DONE = 'done',
  FAILED = 'failed'
}

class KeyCodeValidationStateMachine {
  private state: KeyCodeValidationState = KeyCodeValidationState.IDLE;
  private transitionCount: number = 0;

  public transition(to: KeyCodeValidationState): boolean {
    this.state = to;
    this.transitionCount++;
    return true;
  }

  public current(): KeyCodeValidationState {
    return this.state;
  }

  public count(): number {
    return this.transitionCount;
  }

  public isTerminal(): boolean {
    return this.state === KeyCodeValidationState.DONE || this.state === KeyCodeValidationState.FAILED;
  }

  public reset(): void {
    this.state = KeyCodeValidationState.IDLE;
    this.transitionCount = 0;
  }
}
