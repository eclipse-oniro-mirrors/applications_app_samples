export default function keyCodeValidationTest() {
  describe('KeyCodeValidation_Test', () => {

    it('keyCodeValidationTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new KeyCodeValidationRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: KeyCodeValidationKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('keyCodeValidationTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new KeyCodeValidationMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('keyCodeValidationTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new KeyCodeValidationValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('keyCodeValidationTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new KeyCodeValidationStateMachine();
      machine.transition(KeyCodeValidationState.READY);
      machine.transition(KeyCodeValidationState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(KeyCodeValidationState.RUNNING);
      machine.transition(KeyCodeValidationState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
