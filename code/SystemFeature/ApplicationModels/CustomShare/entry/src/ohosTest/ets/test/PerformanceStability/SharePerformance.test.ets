import { describe, it, expect } from '@ohos/hypium';
import { TIMEOUT_DIALOG_RENDER, yieldTick } from '../Shared/CustomShareDriver';
enum SharePerformanceKind {
  LINK = 'link',
  FILE = 'file',
  OTHER = 'other',
  TEXT = 'text',
  EDIT = 'edit'
}

interface SharePerformanceEntry {
  id: number;
  label: string;
  kind: SharePerformanceKind;
  enabled: boolean;
}

class SharePerformanceRegistry {
  private entries: Map<number, SharePerformanceEntry> = new Map<number, SharePerformanceEntry>();

  public register(entry: SharePerformanceEntry): boolean {
    if (entry.id < 0 || entry.label.length === 0) {
      return false;
    }
    this.entries.set(entry.id, entry);
    return true;
  }

  public contains(id: number): boolean {
    return this.entries.has(id);
  }

  public size(): number {
    return this.entries.size;
  }

  public enabledCount(): number {
    let count: number = 0;
    this.entries.forEach((entry: SharePerformanceEntry) => {
      if (entry.enabled) {
        count++;
      }
    });
    return count;
  }
}
class SharePerformanceMetrics {
  private counts: Map<string, number> = new Map<string, number>();
  private totalAmount: number = 0;

  public record(key: string, amount: number = 1): void {
    const current: number = this.counts.get(key) ?? 0;
    this.counts.set(key, current + amount);
    this.totalAmount += amount;
  }

  public count(key: string): number {
    return this.counts.get(key) ?? 0;
  }

  public total(): number {
    return this.totalAmount;
  }

  public distinct(): number {
    return this.counts.size;
  }

  public average(): number {
    if (this.counts.size === 0) {
      return 0;
    }
    return this.totalAmount / this.counts.size;
  }
}
enum SharePerformanceErrorCode {
  OK = 0,
  EMPTY = 1,
  TOO_LONG = 2,
  INVALID = 3
}

interface SharePerformanceValidationResult {
  ok: boolean;
  code: SharePerformanceErrorCode;
  message: string;
}

class SharePerformanceValidator {
  private maxLength: number;

  constructor(maxLength: number = 64) {
    this.maxLength = maxLength;
  }

  public validate(value: string): SharePerformanceValidationResult {
    if (value.length === 0) {
      return { ok: false, code: SharePerformanceErrorCode.EMPTY, message: 'empty value' };
    }
    if (value.length > this.maxLength) {
      return { ok: false, code: SharePerformanceErrorCode.TOO_LONG, message: 'value too long' };
    }
    return { ok: true, code: SharePerformanceErrorCode.OK, message: 'valid value' };
  }

  public isUrl(value: string): boolean {
    return value.indexOf('http://') === 0 || value.indexOf('https://') === 0;
  }

  public isEmpty(value: string): boolean {
    return value.length === 0;
  }
}
enum SharePerformanceState {
  IDLE = 'idle',
  READY = 'ready',
  RUNNING = 'running',
  DONE = 'done',
  FAILED = 'failed'
}

class SharePerformanceStateMachine {
  private state: SharePerformanceState = SharePerformanceState.IDLE;
  private transitionCount: number = 0;

  public transition(to: SharePerformanceState): boolean {
    this.state = to;
    this.transitionCount++;
    return true;
  }

  public current(): SharePerformanceState {
    return this.state;
  }

  public count(): number {
    return this.transitionCount;
  }

  public isTerminal(): boolean {
    return this.state === SharePerformanceState.DONE || this.state === SharePerformanceState.FAILED;
  }

  public reset(): void {
    this.state = SharePerformanceState.IDLE;
    this.transitionCount = 0;
  }
}
