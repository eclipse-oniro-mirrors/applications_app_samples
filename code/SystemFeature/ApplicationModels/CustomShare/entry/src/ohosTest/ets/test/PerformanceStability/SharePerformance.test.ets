export default function sharePerformanceTest() {
  describe('SharePerformance_Test', () => {

    it('sharePerformanceTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new SharePerformanceRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: SharePerformanceKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
