import { TIMEOUT_DIALOG_RENDER, yieldTick } from '../Shared/CustomShareDriver';
enum CommonEventUtilValidationKind {
  LINK = 'link',
  FILE = 'file',
  OTHER = 'other',
  TEXT = 'text',
  EDIT = 'edit'
}

interface CommonEventUtilValidationEntry {
  id: number;
  label: string;
  kind: CommonEventUtilValidationKind;
  enabled: boolean;
}

class CommonEventUtilValidationRegistry {
  private entries: Map<number, CommonEventUtilValidationEntry> = new Map<number, CommonEventUtilValidationEntry>();

  public register(entry: CommonEventUtilValidationEntry): boolean {
    if (entry.id < 0 || entry.label.length === 0) {
      return false;
    }
    this.entries.set(entry.id, entry);
    return true;
  }

  public contains(id: number): boolean {
    return this.entries.has(id);
  }

  public size(): number {
    return this.entries.size;
  }

  public enabledCount(): number {
    let count: number = 0;
    this.entries.forEach((entry: CommonEventUtilValidationEntry) => {
      if (entry.enabled) {
        count++;
      }
    });
    return count;
  }
}
class CommonEventUtilValidationMetrics {
  private counts: Map<string, number> = new Map<string, number>();
  private totalAmount: number = 0;

  public record(key: string, amount: number = 1): void {
    const current: number = this.counts.get(key) ?? 0;
    this.counts.set(key, current + amount);
    this.totalAmount += amount;
  }

  public count(key: string): number {
    return this.counts.get(key) ?? 0;
  }

  public total(): number {
    return this.totalAmount;
  }

  public distinct(): number {
    return this.counts.size;
  }

  public average(): number {
    if (this.counts.size === 0) {
      return 0;
    }
    return this.totalAmount / this.counts.size;
  }
}
enum CommonEventUtilValidationErrorCode {
  OK = 0,
  EMPTY = 1,
  TOO_LONG = 2,
  INVALID = 3
}

interface CommonEventUtilValidationValidationResult {
  ok: boolean;
  code: CommonEventUtilValidationErrorCode;
  message: string;
}

class CommonEventUtilValidationValidator {
  private maxLength: number;

  constructor(maxLength: number = 64) {
    this.maxLength = maxLength;
  }

  public validate(value: string): CommonEventUtilValidationValidationResult {
    if (value.length === 0) {
      return { ok: false, code: CommonEventUtilValidationErrorCode.EMPTY, message: 'empty value' };
    }
    if (value.length > this.maxLength) {
      return { ok: false, code: CommonEventUtilValidationErrorCode.TOO_LONG, message: 'value too long' };
    }
    return { ok: true, code: CommonEventUtilValidationErrorCode.OK, message: 'valid value' };
  }

  public isUrl(value: string): boolean {
    return value.indexOf('http://') === 0 || value.indexOf('https://') === 0;
  }

  public isEmpty(value: string): boolean {
    return value.length === 0;
  }
}
enum CommonEventUtilValidationState {
  IDLE = 'idle',
  READY = 'ready',
  RUNNING = 'running',
  DONE = 'done',
  FAILED = 'failed'
}

class CommonEventUtilValidationStateMachine {
  private state: CommonEventUtilValidationState = CommonEventUtilValidationState.IDLE;
  private transitionCount: number = 0;

  public transition(to: CommonEventUtilValidationState): boolean {
    this.state = to;
    this.transitionCount++;
    return true;
  }

  public current(): CommonEventUtilValidationState {
    return this.state;
  }

  public count(): number {
    return this.transitionCount;
  }

  public isTerminal(): boolean {
    return this.state === CommonEventUtilValidationState.DONE || this.state === CommonEventUtilValidationState.FAILED;
  }

  public reset(): void {
    this.state = CommonEventUtilValidationState.IDLE;
    this.transitionCount = 0;
  }
}
