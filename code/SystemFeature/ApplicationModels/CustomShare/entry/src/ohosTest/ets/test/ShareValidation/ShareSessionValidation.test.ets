export default function shareSessionValidationTest() {
  describe('ShareSessionValidation_Test', () => {

    it('shareSessionValidationTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new ShareSessionValidationRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: ShareSessionValidationKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('shareSessionValidationTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new ShareSessionValidationMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('shareSessionValidationTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new ShareSessionValidationValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('shareSessionValidationTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new ShareSessionValidationStateMachine();
      machine.transition(ShareSessionValidationState.READY);
      machine.transition(ShareSessionValidationState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(ShareSessionValidationState.RUNNING);
      machine.transition(ShareSessionValidationState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
