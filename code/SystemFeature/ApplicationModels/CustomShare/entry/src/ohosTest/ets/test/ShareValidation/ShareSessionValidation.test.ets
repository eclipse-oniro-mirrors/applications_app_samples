import { describe, it, expect } from '@ohos/hypium';
import { TIMEOUT_DIALOG_RENDER, yieldTick } from '../Shared/CustomShareDriver';
enum ShareSessionValidationKind {
  LINK = 'link',
  FILE = 'file',
  OTHER = 'other',
  TEXT = 'text',
  EDIT = 'edit'
}

interface ShareSessionValidationEntry {
  id: number;
  label: string;
  kind: ShareSessionValidationKind;
  enabled: boolean;
}

class ShareSessionValidationRegistry {
  private entries: Map<number, ShareSessionValidationEntry> = new Map<number, ShareSessionValidationEntry>();

  public register(entry: ShareSessionValidationEntry): boolean {
    if (entry.id < 0 || entry.label.length === 0) {
      return false;
    }
    this.entries.set(entry.id, entry);
    return true;
  }

  public contains(id: number): boolean {
    return this.entries.has(id);
  }

  public size(): number {
    return this.entries.size;
  }

  public enabledCount(): number {
    let count: number = 0;
    this.entries.forEach((entry: ShareSessionValidationEntry) => {
      if (entry.enabled) {
        count++;
      }
    });
    return count;
  }
}
class ShareSessionValidationMetrics {
  private counts: Map<string, number> = new Map<string, number>();
  private totalAmount: number = 0;

  public record(key: string, amount: number = 1): void {
    const current: number = this.counts.get(key) ?? 0;
    this.counts.set(key, current + amount);
    this.totalAmount += amount;
  }

  public count(key: string): number {
    return this.counts.get(key) ?? 0;
  }

  public total(): number {
    return this.totalAmount;
  }

  public distinct(): number {
    return this.counts.size;
  }

  public average(): number {
    if (this.counts.size === 0) {
      return 0;
    }
    return this.totalAmount / this.counts.size;
  }
}
enum ShareSessionValidationErrorCode {
  OK = 0,
  EMPTY = 1,
  TOO_LONG = 2,
  INVALID = 3
}

interface ShareSessionValidationValidationResult {
  ok: boolean;
  code: ShareSessionValidationErrorCode;
  message: string;
}

class ShareSessionValidationValidator {
  private maxLength: number;

  constructor(maxLength: number = 64) {
    this.maxLength = maxLength;
  }

  public validate(value: string): ShareSessionValidationValidationResult {
    if (value.length === 0) {
      return { ok: false, code: ShareSessionValidationErrorCode.EMPTY, message: 'empty value' };
    }
    if (value.length > this.maxLength) {
      return { ok: false, code: ShareSessionValidationErrorCode.TOO_LONG, message: 'value too long' };
    }
    return { ok: true, code: ShareSessionValidationErrorCode.OK, message: 'valid value' };
  }

  public isUrl(value: string): boolean {
    return value.indexOf('http://') === 0 || value.indexOf('https://') === 0;
  }

  public isEmpty(value: string): boolean {
    return value.length === 0;
  }
}
enum ShareSessionValidationState {
  IDLE = 'idle',
  READY = 'ready',
  RUNNING = 'running',
  DONE = 'done',
  FAILED = 'failed'
}

class ShareSessionValidationStateMachine {
  private state: ShareSessionValidationState = ShareSessionValidationState.IDLE;
  private transitionCount: number = 0;

  public transition(to: ShareSessionValidationState): boolean {
    this.state = to;
    this.transitionCount++;
    return true;
  }

  public current(): ShareSessionValidationState {
    return this.state;
  }

  public count(): number {
    return this.transitionCount;
  }

  public isTerminal(): boolean {
    return this.state === ShareSessionValidationState.DONE || this.state === ShareSessionValidationState.FAILED;
  }

  public reset(): void {
    this.state = ShareSessionValidationState.IDLE;
    this.transitionCount = 0;
  }
}
