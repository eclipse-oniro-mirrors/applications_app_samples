import { describe, it, expect } from '@ohos/hypium';
import { TIMEOUT_DIALOG_RENDER, yieldTick } from '../Shared/CustomShareDriver';
enum LocalizationTestingKind {
  LINK = 'link',
  FILE = 'file',
  OTHER = 'other',
  TEXT = 'text',
  EDIT = 'edit'
}

interface LocalizationTestingEntry {
  id: number;
  label: string;
  kind: LocalizationTestingKind;
  enabled: boolean;
}

class LocalizationTestingRegistry {
  private entries: Map<number, LocalizationTestingEntry> = new Map<number, LocalizationTestingEntry>();

  public register(entry: LocalizationTestingEntry): boolean {
    if (entry.id < 0 || entry.label.length === 0) {
      return false;
    }
    this.entries.set(entry.id, entry);
    return true;
  }

  public contains(id: number): boolean {
    return this.entries.has(id);
  }

  public size(): number {
    return this.entries.size;
  }

  public enabledCount(): number {
    let count: number = 0;
    this.entries.forEach((entry: LocalizationTestingEntry) => {
      if (entry.enabled) {
        count++;
      }
    });
    return count;
  }
}
class LocalizationTestingMetrics {
  private counts: Map<string, number> = new Map<string, number>();
  private totalAmount: number = 0;

  public record(key: string, amount: number = 1): void {
    const current: number = this.counts.get(key) ?? 0;
    this.counts.set(key, current + amount);
    this.totalAmount += amount;
  }

  public count(key: string): number {
    return this.counts.get(key) ?? 0;
  }

  public total(): number {
    return this.totalAmount;
  }

  public distinct(): number {
    return this.counts.size;
  }

  public average(): number {
    if (this.counts.size === 0) {
      return 0;
    }
    return this.totalAmount / this.counts.size;
  }
}
enum LocalizationTestingErrorCode {
  OK = 0,
  EMPTY = 1,
  TOO_LONG = 2,
  INVALID = 3
}

interface LocalizationTestingValidationResult {
  ok: boolean;
  code: LocalizationTestingErrorCode;
  message: string;
}

class LocalizationTestingValidator {
  private maxLength: number;

  constructor(maxLength: number = 64) {
    this.maxLength = maxLength;
  }

  public validate(value: string): LocalizationTestingValidationResult {
    if (value.length === 0) {
      return { ok: false, code: LocalizationTestingErrorCode.EMPTY, message: 'empty value' };
    }
    if (value.length > this.maxLength) {
      return { ok: false, code: LocalizationTestingErrorCode.TOO_LONG, message: 'value too long' };
    }
    return { ok: true, code: LocalizationTestingErrorCode.OK, message: 'valid value' };
  }

  public isUrl(value: string): boolean {
    return value.indexOf('http://') === 0 || value.indexOf('https://') === 0;
  }

  public isEmpty(value: string): boolean {
    return value.length === 0;
  }
}
enum LocalizationTestingState {
  IDLE = 'idle',
  READY = 'ready',
  RUNNING = 'running',
  DONE = 'done',
  FAILED = 'failed'
}

class LocalizationTestingStateMachine {
  private state: LocalizationTestingState = LocalizationTestingState.IDLE;
  private transitionCount: number = 0;

  public transition(to: LocalizationTestingState): boolean {
    this.state = to;
    this.transitionCount++;
    return true;
  }

  public current(): LocalizationTestingState {
    return this.state;
  }

  public count(): number {
    return this.transitionCount;
  }

  public isTerminal(): boolean {
    return this.state === LocalizationTestingState.DONE || this.state === LocalizationTestingState.FAILED;
  }

  public reset(): void {
    this.state = LocalizationTestingState.IDLE;
    this.transitionCount = 0;
  }
}
