export default function localizationTestingTest() {
  describe('LocalizationTesting_Test', () => {

    it('localizationTestingTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new LocalizationTestingRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: LocalizationTestingKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('localizationTestingTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new LocalizationTestingMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('localizationTestingTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new LocalizationTestingValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('localizationTestingTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new LocalizationTestingStateMachine();
      machine.transition(LocalizationTestingState.READY);
      machine.transition(LocalizationTestingState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(LocalizationTestingState.RUNNING);
      machine.transition(LocalizationTestingState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
