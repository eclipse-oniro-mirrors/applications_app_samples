export default function shareSecurityTest() {
  describe('ShareSecurity_Test', () => {

    it('shareSecurityTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new ShareSecurityRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: ShareSecurityKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('shareSecurityTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new ShareSecurityMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('shareSecurityTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new ShareSecurityValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('shareSecurityTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new ShareSecurityStateMachine();
      machine.transition(ShareSecurityState.READY);
      machine.transition(ShareSecurityState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(ShareSecurityState.RUNNING);
      machine.transition(ShareSecurityState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
