export default function shareOperationsTest() {
  describe('ShareOperations_Test', () => {

    it('shareOperationsTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new ShareOperationsRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: ShareOperationsKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('shareOperationsTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new ShareOperationsMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('shareOperationsTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new ShareOperationsValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('shareOperationsTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new ShareOperationsStateMachine();
      machine.transition(ShareOperationsState.READY);
      machine.transition(ShareOperationsState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(ShareOperationsState.RUNNING);
      machine.transition(ShareOperationsState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
