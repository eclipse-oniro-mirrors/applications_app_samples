import { describe, it, expect } from '@ohos/hypium';
import { TIMEOUT_DIALOG_RENDER, yieldTick } from '../Shared/CustomShareDriver';
enum ShareNotificationKind {
  LINK = 'link',
  FILE = 'file',
  OTHER = 'other',
  TEXT = 'text',
  EDIT = 'edit'
}

interface ShareNotificationEntry {
  id: number;
  label: string;
  kind: ShareNotificationKind;
  enabled: boolean;
}

class ShareNotificationRegistry {
  private entries: Map<number, ShareNotificationEntry> = new Map<number, ShareNotificationEntry>();

  public register(entry: ShareNotificationEntry): boolean {
    if (entry.id < 0 || entry.label.length === 0) {
      return false;
    }
    this.entries.set(entry.id, entry);
    return true;
  }

  public contains(id: number): boolean {
    return this.entries.has(id);
  }

  public size(): number {
    return this.entries.size;
  }

  public enabledCount(): number {
    let count: number = 0;
    this.entries.forEach((entry: ShareNotificationEntry) => {
      if (entry.enabled) {
        count++;
      }
    });
    return count;
  }
}
class ShareNotificationMetrics {
  private counts: Map<string, number> = new Map<string, number>();
  private totalAmount: number = 0;

  public record(key: string, amount: number = 1): void {
    const current: number = this.counts.get(key) ?? 0;
    this.counts.set(key, current + amount);
    this.totalAmount += amount;
  }

  public count(key: string): number {
    return this.counts.get(key) ?? 0;
  }

  public total(): number {
    return this.totalAmount;
  }

  public distinct(): number {
    return this.counts.size;
  }

  public average(): number {
    if (this.counts.size === 0) {
      return 0;
    }
    return this.totalAmount / this.counts.size;
  }
}
enum ShareNotificationErrorCode {
  OK = 0,
  EMPTY = 1,
  TOO_LONG = 2,
  INVALID = 3
}

interface ShareNotificationValidationResult {
  ok: boolean;
  code: ShareNotificationErrorCode;
  message: string;
}

class ShareNotificationValidator {
  private maxLength: number;

  constructor(maxLength: number = 64) {
    this.maxLength = maxLength;
  }

  public validate(value: string): ShareNotificationValidationResult {
    if (value.length === 0) {
      return { ok: false, code: ShareNotificationErrorCode.EMPTY, message: 'empty value' };
    }
    if (value.length > this.maxLength) {
      return { ok: false, code: ShareNotificationErrorCode.TOO_LONG, message: 'value too long' };
    }
    return { ok: true, code: ShareNotificationErrorCode.OK, message: 'valid value' };
  }

  public isUrl(value: string): boolean {
    return value.indexOf('http://') === 0 || value.indexOf('https://') === 0;
  }

  public isEmpty(value: string): boolean {
    return value.length === 0;
  }
}
enum ShareNotificationState {
  IDLE = 'idle',
  READY = 'ready',
  RUNNING = 'running',
  DONE = 'done',
  FAILED = 'failed'
}

class ShareNotificationStateMachine {
  private state: ShareNotificationState = ShareNotificationState.IDLE;
  private transitionCount: number = 0;

  public transition(to: ShareNotificationState): boolean {
    this.state = to;
    this.transitionCount++;
    return true;
  }

  public current(): ShareNotificationState {
    return this.state;
  }

  public count(): number {
    return this.transitionCount;
  }

  public isTerminal(): boolean {
    return this.state === ShareNotificationState.DONE || this.state === ShareNotificationState.FAILED;
  }

  public reset(): void {
    this.state = ShareNotificationState.IDLE;
    this.transitionCount = 0;
  }
}
