export default function shareNotificationTest() {
  describe('ShareNotification_Test', () => {

    it('shareNotificationTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new ShareNotificationRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: ShareNotificationKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('shareNotificationTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new ShareNotificationMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('shareNotificationTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new ShareNotificationValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('shareNotificationTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new ShareNotificationStateMachine();
      machine.transition(ShareNotificationState.READY);
      machine.transition(ShareNotificationState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(ShareNotificationState.RUNNING);
      machine.transition(ShareNotificationState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
