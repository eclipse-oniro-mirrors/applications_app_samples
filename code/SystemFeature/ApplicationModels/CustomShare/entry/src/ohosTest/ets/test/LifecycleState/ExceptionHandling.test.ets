export default function exceptionHandlingTest() {
  describe('ExceptionHandling_Test', () => {

    it('exceptionHandlingTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new ExceptionHandlingRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: ExceptionHandlingKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('exceptionHandlingTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new ExceptionHandlingMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('exceptionHandlingTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new ExceptionHandlingValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('exceptionHandlingTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new ExceptionHandlingStateMachine();
      machine.transition(ExceptionHandlingState.READY);
      machine.transition(ExceptionHandlingState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(ExceptionHandlingState.RUNNING);
      machine.transition(ExceptionHandlingState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
