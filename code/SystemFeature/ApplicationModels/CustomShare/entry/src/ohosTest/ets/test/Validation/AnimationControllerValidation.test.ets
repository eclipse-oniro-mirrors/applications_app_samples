export default function animationControllerValidationTest() {
  describe('AnimationControllerValidation_Test', () => {

    it('animationControllerValidationTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new AnimationControllerValidationRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: AnimationControllerValidationKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('animationControllerValidationTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new AnimationControllerValidationMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('animationControllerValidationTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new AnimationControllerValidationValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('animationControllerValidationTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new AnimationControllerValidationStateMachine();
      machine.transition(AnimationControllerValidationState.READY);
      machine.transition(AnimationControllerValidationState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(AnimationControllerValidationState.RUNNING);
      machine.transition(AnimationControllerValidationState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
