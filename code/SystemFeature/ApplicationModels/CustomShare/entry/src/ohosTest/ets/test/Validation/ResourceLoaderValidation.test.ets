export default function resourceLoaderValidationTest() {
  describe('ResourceLoaderValidation_Test', () => {

    it('resourceLoaderValidationTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new ResourceLoaderValidationRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: ResourceLoaderValidationKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('resourceLoaderValidationTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new ResourceLoaderValidationMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('resourceLoaderValidationTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new ResourceLoaderValidationValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('resourceLoaderValidationTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new ResourceLoaderValidationStateMachine();
      machine.transition(ResourceLoaderValidationState.READY);
      machine.transition(ResourceLoaderValidationState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(ResourceLoaderValidationState.RUNNING);
      machine.transition(ResourceLoaderValidationState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
