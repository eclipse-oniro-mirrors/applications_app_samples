import { TIMEOUT_DIALOG_RENDER, yieldTick } from '../Shared/CustomShareDriver';
enum ResourceLoaderValidationKind {
  LINK = 'link',
  FILE = 'file',
  OTHER = 'other',
  TEXT = 'text',
  EDIT = 'edit'
}

interface ResourceLoaderValidationEntry {
  id: number;
  label: string;
  kind: ResourceLoaderValidationKind;
  enabled: boolean;
}

class ResourceLoaderValidationRegistry {
  private entries: Map<number, ResourceLoaderValidationEntry> = new Map<number, ResourceLoaderValidationEntry>();

  public register(entry: ResourceLoaderValidationEntry): boolean {
    if (entry.id < 0 || entry.label.length === 0) {
      return false;
    }
    this.entries.set(entry.id, entry);
    return true;
  }

  public contains(id: number): boolean {
    return this.entries.has(id);
  }

  public size(): number {
    return this.entries.size;
  }

  public enabledCount(): number {
    let count: number = 0;
    this.entries.forEach((entry: ResourceLoaderValidationEntry) => {
      if (entry.enabled) {
        count++;
      }
    });
    return count;
  }
}
class ResourceLoaderValidationMetrics {
  private counts: Map<string, number> = new Map<string, number>();
  private totalAmount: number = 0;

  public record(key: string, amount: number = 1): void {
    const current: number = this.counts.get(key) ?? 0;
    this.counts.set(key, current + amount);
    this.totalAmount += amount;
  }

  public count(key: string): number {
    return this.counts.get(key) ?? 0;
  }

  public total(): number {
    return this.totalAmount;
  }

  public distinct(): number {
    return this.counts.size;
  }

  public average(): number {
    if (this.counts.size === 0) {
      return 0;
    }
    return this.totalAmount / this.counts.size;
  }
}
enum ResourceLoaderValidationErrorCode {
  OK = 0,
  EMPTY = 1,
  TOO_LONG = 2,
  INVALID = 3
}

interface ResourceLoaderValidationValidationResult {
  ok: boolean;
  code: ResourceLoaderValidationErrorCode;
  message: string;
}

class ResourceLoaderValidationValidator {
  private maxLength: number;

  constructor(maxLength: number = 64) {
    this.maxLength = maxLength;
  }

  public validate(value: string): ResourceLoaderValidationValidationResult {
    if (value.length === 0) {
      return { ok: false, code: ResourceLoaderValidationErrorCode.EMPTY, message: 'empty value' };
    }
    if (value.length > this.maxLength) {
      return { ok: false, code: ResourceLoaderValidationErrorCode.TOO_LONG, message: 'value too long' };
    }
    return { ok: true, code: ResourceLoaderValidationErrorCode.OK, message: 'valid value' };
  }

  public isUrl(value: string): boolean {
    return value.indexOf('http://') === 0 || value.indexOf('https://') === 0;
  }

  public isEmpty(value: string): boolean {
    return value.length === 0;
  }
}
enum ResourceLoaderValidationState {
  IDLE = 'idle',
  READY = 'ready',
  RUNNING = 'running',
  DONE = 'done',
  FAILED = 'failed'
}

class ResourceLoaderValidationStateMachine {
  private state: ResourceLoaderValidationState = ResourceLoaderValidationState.IDLE;
  private transitionCount: number = 0;

  public transition(to: ResourceLoaderValidationState): boolean {
    this.state = to;
    this.transitionCount++;
    return true;
  }

  public current(): ResourceLoaderValidationState {
    return this.state;
  }

  public count(): number {
    return this.transitionCount;
  }

  public isTerminal(): boolean {
    return this.state === ResourceLoaderValidationState.DONE || this.state === ResourceLoaderValidationState.FAILED;
  }

  public reset(): void {
    this.state = ResourceLoaderValidationState.IDLE;
    this.transitionCount = 0;
  }
}
