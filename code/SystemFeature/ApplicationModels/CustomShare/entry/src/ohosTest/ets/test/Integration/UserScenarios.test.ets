import { describe, it, expect } from '@ohos/hypium';
import { TIMEOUT_DIALOG_RENDER, yieldTick } from '../Shared/CustomShareDriver';
enum UserScenariosKind {
  LINK = 'link',
  FILE = 'file',
  OTHER = 'other',
  TEXT = 'text',
  EDIT = 'edit'
}

interface UserScenariosEntry {
  id: number;
  label: string;
  kind: UserScenariosKind;
  enabled: boolean;
}

class UserScenariosRegistry {
  private entries: Map<number, UserScenariosEntry> = new Map<number, UserScenariosEntry>();

  public register(entry: UserScenariosEntry): boolean {
    if (entry.id < 0 || entry.label.length === 0) {
      return false;
    }
    this.entries.set(entry.id, entry);
    return true;
  }

  public contains(id: number): boolean {
    return this.entries.has(id);
  }

  public size(): number {
    return this.entries.size;
  }

  public enabledCount(): number {
    let count: number = 0;
    this.entries.forEach((entry: UserScenariosEntry) => {
      if (entry.enabled) {
        count++;
      }
    });
    return count;
  }
}
class UserScenariosMetrics {
  private counts: Map<string, number> = new Map<string, number>();
  private totalAmount: number = 0;

  public record(key: string, amount: number = 1): void {
    const current: number = this.counts.get(key) ?? 0;
    this.counts.set(key, current + amount);
    this.totalAmount += amount;
  }

  public count(key: string): number {
    return this.counts.get(key) ?? 0;
  }

  public total(): number {
    return this.totalAmount;
  }

  public distinct(): number {
    return this.counts.size;
  }

  public average(): number {
    if (this.counts.size === 0) {
      return 0;
    }
    return this.totalAmount / this.counts.size;
  }
}
enum UserScenariosErrorCode {
  OK = 0,
  EMPTY = 1,
  TOO_LONG = 2,
  INVALID = 3
}

interface UserScenariosValidationResult {
  ok: boolean;
  code: UserScenariosErrorCode;
  message: string;
}

class UserScenariosValidator {
  private maxLength: number;

  constructor(maxLength: number = 64) {
    this.maxLength = maxLength;
  }

  public validate(value: string): UserScenariosValidationResult {
    if (value.length === 0) {
      return { ok: false, code: UserScenariosErrorCode.EMPTY, message: 'empty value' };
    }
    if (value.length > this.maxLength) {
      return { ok: false, code: UserScenariosErrorCode.TOO_LONG, message: 'value too long' };
    }
    return { ok: true, code: UserScenariosErrorCode.OK, message: 'valid value' };
  }

  public isUrl(value: string): boolean {
    return value.indexOf('http://') === 0 || value.indexOf('https://') === 0;
  }

  public isEmpty(value: string): boolean {
    return value.length === 0;
  }
}
enum UserScenariosState {
  IDLE = 'idle',
  READY = 'ready',
  RUNNING = 'running',
  DONE = 'done',
  FAILED = 'failed'
}

class UserScenariosStateMachine {
  private state: UserScenariosState = UserScenariosState.IDLE;
  private transitionCount: number = 0;

  public transition(to: UserScenariosState): boolean {
    this.state = to;
    this.transitionCount++;
    return true;
  }

  public current(): UserScenariosState {
    return this.state;
  }

  public count(): number {
    return this.transitionCount;
  }

  public isTerminal(): boolean {
    return this.state === UserScenariosState.DONE || this.state === UserScenariosState.FAILED;
  }

  public reset(): void {
    this.state = UserScenariosState.IDLE;
    this.transitionCount = 0;
  }
}
