export default function userScenariosTest() {
  describe('UserScenarios_Test', () => {

    it('userScenariosTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new UserScenariosRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: UserScenariosKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('userScenariosTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new UserScenariosMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('userScenariosTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new UserScenariosValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('userScenariosTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new UserScenariosStateMachine();
      machine.transition(UserScenariosState.READY);
      machine.transition(UserScenariosState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(UserScenariosState.RUNNING);
      machine.transition(UserScenariosState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
