import { describe, it, expect } from '@ohos/hypium';
import { TIMEOUT_DIALOG_RENDER, yieldTick } from '../Shared/CustomShareDriver';
enum ShareMenuConfigurationKind {
  LINK = 'link',
  FILE = 'file',
  OTHER = 'other',
  TEXT = 'text',
  EDIT = 'edit'
}

interface ShareMenuConfigurationEntry {
  id: number;
  label: string;
  kind: ShareMenuConfigurationKind;
  enabled: boolean;
}

class ShareMenuConfigurationRegistry {
  private entries: Map<number, ShareMenuConfigurationEntry> = new Map<number, ShareMenuConfigurationEntry>();

  public register(entry: ShareMenuConfigurationEntry): boolean {
    if (entry.id < 0 || entry.label.length === 0) {
      return false;
    }
    this.entries.set(entry.id, entry);
    return true;
  }

  public contains(id: number): boolean {
    return this.entries.has(id);
  }

  public size(): number {
    return this.entries.size;
  }

  public enabledCount(): number {
    let count: number = 0;
    this.entries.forEach((entry: ShareMenuConfigurationEntry) => {
      if (entry.enabled) {
        count++;
      }
    });
    return count;
  }
}
class ShareMenuConfigurationMetrics {
  private counts: Map<string, number> = new Map<string, number>();
  private totalAmount: number = 0;

  public record(key: string, amount: number = 1): void {
    const current: number = this.counts.get(key) ?? 0;
    this.counts.set(key, current + amount);
    this.totalAmount += amount;
  }

  public count(key: string): number {
    return this.counts.get(key) ?? 0;
  }

  public total(): number {
    return this.totalAmount;
  }

  public distinct(): number {
    return this.counts.size;
  }

  public average(): number {
    if (this.counts.size === 0) {
      return 0;
    }
    return this.totalAmount / this.counts.size;
  }
}
enum ShareMenuConfigurationErrorCode {
  OK = 0,
  EMPTY = 1,
  TOO_LONG = 2,
  INVALID = 3
}

interface ShareMenuConfigurationValidationResult {
  ok: boolean;
  code: ShareMenuConfigurationErrorCode;
  message: string;
}

class ShareMenuConfigurationValidator {
  private maxLength: number;

  constructor(maxLength: number = 64) {
    this.maxLength = maxLength;
  }

  public validate(value: string): ShareMenuConfigurationValidationResult {
    if (value.length === 0) {
      return { ok: false, code: ShareMenuConfigurationErrorCode.EMPTY, message: 'empty value' };
    }
    if (value.length > this.maxLength) {
      return { ok: false, code: ShareMenuConfigurationErrorCode.TOO_LONG, message: 'value too long' };
    }
    return { ok: true, code: ShareMenuConfigurationErrorCode.OK, message: 'valid value' };
  }

  public isUrl(value: string): boolean {
    return value.indexOf('http://') === 0 || value.indexOf('https://') === 0;
  }

  public isEmpty(value: string): boolean {
    return value.length === 0;
  }
}
enum ShareMenuConfigurationState {
  IDLE = 'idle',
  READY = 'ready',
  RUNNING = 'running',
  DONE = 'done',
  FAILED = 'failed'
}

class ShareMenuConfigurationStateMachine {
  private state: ShareMenuConfigurationState = ShareMenuConfigurationState.IDLE;
  private transitionCount: number = 0;

  public transition(to: ShareMenuConfigurationState): boolean {
    this.state = to;
    this.transitionCount++;
    return true;
  }

  public current(): ShareMenuConfigurationState {
    return this.state;
  }

  public count(): number {
    return this.transitionCount;
  }

  public isTerminal(): boolean {
    return this.state === ShareMenuConfigurationState.DONE || this.state === ShareMenuConfigurationState.FAILED;
  }

  public reset(): void {
    this.state = ShareMenuConfigurationState.IDLE;
    this.transitionCount = 0;
  }
}
