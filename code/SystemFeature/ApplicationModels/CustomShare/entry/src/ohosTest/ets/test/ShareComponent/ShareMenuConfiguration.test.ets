export default function shareMenuConfigurationTest() {
  describe('ShareMenuConfiguration_Test', () => {

    it('shareMenuConfigurationTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new ShareMenuConfigurationRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: ShareMenuConfigurationKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('shareMenuConfigurationTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new ShareMenuConfigurationMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('shareMenuConfigurationTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new ShareMenuConfigurationValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('shareMenuConfigurationTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new ShareMenuConfigurationStateMachine();
      machine.transition(ShareMenuConfigurationState.READY);
      machine.transition(ShareMenuConfigurationState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(ShareMenuConfigurationState.RUNNING);
      machine.transition(ShareMenuConfigurationState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
