import { describe, it, expect } from '@ohos/hypium';
import { TIMEOUT_DIALOG_RENDER, yieldTick } from '../Shared/CustomShareDriver';
enum InputValidationKind {
  LINK = 'link',
  FILE = 'file',
  OTHER = 'other',
  TEXT = 'text',
  EDIT = 'edit'
}

interface InputValidationEntry {
  id: number;
  label: string;
  kind: InputValidationKind;
  enabled: boolean;
}

class InputValidationRegistry {
  private entries: Map<number, InputValidationEntry> = new Map<number, InputValidationEntry>();

  public register(entry: InputValidationEntry): boolean {
    if (entry.id < 0 || entry.label.length === 0) {
      return false;
    }
    this.entries.set(entry.id, entry);
    return true;
  }

  public contains(id: number): boolean {
    return this.entries.has(id);
  }

  public size(): number {
    return this.entries.size;
  }

  public enabledCount(): number {
    let count: number = 0;
    this.entries.forEach((entry: InputValidationEntry) => {
      if (entry.enabled) {
        count++;
      }
    });
    return count;
  }
}
class InputValidationMetrics {
  private counts: Map<string, number> = new Map<string, number>();
  private totalAmount: number = 0;

  public record(key: string, amount: number = 1): void {
    const current: number = this.counts.get(key) ?? 0;
    this.counts.set(key, current + amount);
    this.totalAmount += amount;
  }

  public count(key: string): number {
    return this.counts.get(key) ?? 0;
  }

  public total(): number {
    return this.totalAmount;
  }

  public distinct(): number {
    return this.counts.size;
  }

  public average(): number {
    if (this.counts.size === 0) {
      return 0;
    }
    return this.totalAmount / this.counts.size;
  }
}
enum InputValidationErrorCode {
  OK = 0,
  EMPTY = 1,
  TOO_LONG = 2,
  INVALID = 3
}

interface InputValidationValidationResult {
  ok: boolean;
  code: InputValidationErrorCode;
  message: string;
}

class InputValidationValidator {
  private maxLength: number;

  constructor(maxLength: number = 64) {
    this.maxLength = maxLength;
  }

  public validate(value: string): InputValidationValidationResult {
    if (value.length === 0) {
      return { ok: false, code: InputValidationErrorCode.EMPTY, message: 'empty value' };
    }
    if (value.length > this.maxLength) {
      return { ok: false, code: InputValidationErrorCode.TOO_LONG, message: 'value too long' };
    }
    return { ok: true, code: InputValidationErrorCode.OK, message: 'valid value' };
  }

  public isUrl(value: string): boolean {
    return value.indexOf('http://') === 0 || value.indexOf('https://') === 0;
  }

  public isEmpty(value: string): boolean {
    return value.length === 0;
  }
}
enum InputValidationState {
  IDLE = 'idle',
  READY = 'ready',
  RUNNING = 'running',
  DONE = 'done',
  FAILED = 'failed'
}

class InputValidationStateMachine {
  private state: InputValidationState = InputValidationState.IDLE;
  private transitionCount: number = 0;

  public transition(to: InputValidationState): boolean {
    this.state = to;
    this.transitionCount++;
    return true;
  }

  public current(): InputValidationState {
    return this.state;
  }

  public count(): number {
    return this.transitionCount;
  }

  public isTerminal(): boolean {
    return this.state === InputValidationState.DONE || this.state === InputValidationState.FAILED;
  }

  public reset(): void {
    this.state = InputValidationState.IDLE;
    this.transitionCount = 0;
  }
}
