export default function inputValidationTest() {
  describe('InputValidation_Test', () => {

    it('inputValidationTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new InputValidationRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: InputValidationKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('inputValidationTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new InputValidationMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('inputValidationTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new InputValidationValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('inputValidationTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new InputValidationStateMachine();
      machine.transition(InputValidationState.READY);
      machine.transition(InputValidationState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(InputValidationState.RUNNING);
      machine.transition(InputValidationState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
