export default function dialogStateManagerValidationTest() {
  describe('DialogStateManagerValidation_Test', () => {

    it('dialogStateManagerValidationTest_share_registry_0', 0, async () => {
      await yieldTick();
      const registry = new DialogStateManagerValidationRegistry();
      expect(registry.register({ id: 0, label: 'share_0', kind: DialogStateManagerValidationKind.LINK, enabled: true })).assertTrue();
      expect(registry.contains(0)).assertTrue();
      expect(registry.size()).assertEqual(1);
    });
    it('dialogStateManagerValidationTest_share_metrics_1', 0, async () => {
      await yieldTick();
      const metrics = new DialogStateManagerValidationMetrics();
      metrics.record('link', 2);
      metrics.record('file', 3);
      expect(metrics.total()).assertEqual(5);
      expect(metrics.count('link')).assertEqual(2);
      expect(metrics.distinct()).assertEqual(2);
    });
    it('dialogStateManagerValidationTest_share_validate_2', 0, async () => {
      await yieldTick();
      const validator = new DialogStateManagerValidationValidator(8);
      expect(validator.validate('').ok).assertFalse();
      expect(validator.validate('share').ok).assertTrue();
      expect(validator.validate('oversized').ok).assertFalse();
      expect(validator.isUrl('https://example.com/share')).assertTrue();
    });
    it('dialogStateManagerValidationTest_share_state_3', 0, async () => {
      await yieldTick();
      const machine = new DialogStateManagerValidationStateMachine();
      machine.transition(DialogStateManagerValidationState.READY);
      machine.transition(DialogStateManagerValidationState.RUNNING);
      expect(machine.count()).assertEqual(2);
      expect(machine.current()).assertEqual(DialogStateManagerValidationState.RUNNING);
      machine.transition(DialogStateManagerValidationState.DONE);
      expect(machine.isTerminal()).assertTrue();
    });
  });
}
