        parsed.data.length
      ).assertEqual(
        1
      );
      expect(
        parsed.data[0].sid
      ).assertEqual(
        'cust.switchScreens'
      );
    });
    it('IN4_analysisServices_13', 0, () => {
      const payload: string = '{"seq":14,"services":[{"sid":"cust.waterDetector","data":{"on":5}}]}';
      const states: InfDeviceState[] = analysisPayload(payload);
