      ).assertEqual(
        'd11'
      );
      expect(
        device.status
      ).assertEqual(
        'online'
      );
      expect(
        device.protocolType
      ).assertEqual(
        'ble'
      );
    });
    it('IN4_buildQuery_12', 0, () => {
