{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "default",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "skillProfiles": [
      {
        "name": "skill-test",
        "abilityName": "EntryAbility",
        "srcEntries": [
          "../../skills/skill-test/scripts/TestSkill.ets"
        ],
        "version": "1.0.0",
        "permissions": [
          "ohos.permission.MANAGE_SKILL_PRIVILEGE"
        ]
      },
      {
        "name": "skill-echo",
        "abilityName": "EntryAbility",
        "srcEntries": [
          "../../skills/skill-echo/scripts/EchoSkill.ets"
        ],
        "version": "1.0.0",
        "permissions": [
          "ohos.permission.MANAGE_SKILL_PRIVILEGE"
        ]
      },
      {
        "name": "skill-calculator",
        "abilityName": "EntryAbility",
        "srcEntries": [
          "../../skills/skill-calculator/scripts/CalculatorSkill.ets"
        ],
        "version": "1.0.0",
        "permissions": [
          "ohos.permission.MANAGE_SKILL_PRIVILEGE"
        ]
      },
      {
        "name": "skill-validation",
        "abilityName": "EntryAbility",
        "srcEntries": [
          "../../skills/skill-validation/scripts/ValidationSkill.ets"
        ],
        "version": "1.0.0",
        "permissions": [
          "ohos.permission.MANAGE_SKILL_PRIVILEGE"
        ]
      }
    ],
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.kernel.SUPPORT_LOCAL_PLUGIN"
      },
      {
        "name": "ohos.permission.MANAGE_SKILL_PRIVILEGE"
      },
      {
        "name": "ohos.permission.READ_WRITE_USER_FILE"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}