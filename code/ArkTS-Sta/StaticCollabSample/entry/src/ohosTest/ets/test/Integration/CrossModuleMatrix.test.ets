    it('recorder_mirrors_bridge_events', 0, async () => {
      const bridge = new MockCollabBridge();
      const recorder = new CollabEventRecorder();
      const sid = bridge.createAbilityConnectionSession(COLLAB_SESSION_NAME, buildPeerInfo('dev'), buildConnectOptions(true));
      recorder.record(CollabEventType.CREATE, sid, COLLAB_SESSION_NAME);
      bridge.connect(sid);
      recorder.record(CollabEventType.CONNECT, sid, 'connect');
      bridge.sendMessage(sid, 'hi');
      recorder.record(CollabEventType.SEND_MESSAGE, sid, 'hi');
      bridge.disconnect(sid);
      recorder.record(CollabEventType.DISCONNECT, sid, 'disconnect');
      bridge.destroyAbilityConnectionSession(sid);
      recorder.record(CollabEventType.DESTROY, sid, 'destroyed');
      expect(recorder.countOf(CollabEventType.CREATE)).assertEqual(bridge.getEventCount(CollabEventType.CREATE));
      expect(recorder.countOf(CollabEventType.CONNECT)).assertEqual(bridge.getEventCount(CollabEventType.CONNECT));
      expect(recorder.countOf(CollabEventType.SEND_MESSAGE)).assertEqual(bridge.getEventCount(CollabEventType.SEND_MESSAGE));
      expect(recorder.countOf(CollabEventType.DISCONNECT)).assertEqual(bridge.getEventCount(CollabEventType.DISCONNECT));
      expect(recorder.countOf(CollabEventType.DESTROY)).assertEqual(bridge.getEventCount(CollabEventType.DESTROY));
      expect(recorder.sequenceOfTypes().length).assertEqual(5);
    });

