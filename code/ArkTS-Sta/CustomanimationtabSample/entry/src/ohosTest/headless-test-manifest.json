      "expectedAssertions": [
        "expect(actual.id).assertEqual('comment-1')",
        "expect(actual.url).assertEqual('https://example.com/avatar.png')",
        "expect(actual.user).assertEqual('reader')",
        "expect(actual.replyId).assertEqual('parent-1')",
        "expect(actual.replyUser).assertEqual('parent-reader')",
