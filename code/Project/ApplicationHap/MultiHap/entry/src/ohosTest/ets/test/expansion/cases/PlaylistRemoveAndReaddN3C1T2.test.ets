    expect(state.playlist[1].trackNumber).assertEqual(2);
    expect(state.playlist[2] === input[2]).assertTrue();
    expect(state.playlist[2].id).assertEqual('song-2');
    expect(state.playlist[2].title).assertEqual('Track 2');
    expect(state.playlist[2].artist).assertEqual('Artist 2');
    expect(state.playlist[2].album).assertEqual('Expansion Album');
    expect(state.playlist[2].coverUrl).assertEqual('test-cover-2');
    expect(state.playlist[2].duration).assertEqual(62);
    expect(state.playlist[2].filePath).assertEqual('/test-only/track-2.mp3');
    expect(state.playlist[2].isLiked).assertEqual(false);
    expect(state.playlist[2].genre).assertEqual('Genre 2');
    expect(state.playlist[2].trackNumber).assertEqual(3);
    expect(appended.length).assertEqual(1);
    expect(appended[0] === input[2]).assertTrue();
    expect(appended[0].id).assertEqual('song-2');
    expect(appended[0].title).assertEqual('Track 2');
    expect(appended[0].artist).assertEqual('Artist 2');
    expect(appended[0].album).assertEqual('Expansion Album');
    expect(appended[0].coverUrl).assertEqual('test-cover-2');
    expect(appended[0].duration).assertEqual(62);
    expect(appended[0].filePath).assertEqual('/test-only/track-2.mp3');
    expect(appended[0].isLiked).assertEqual(false);
    expect(appended[0].genre).assertEqual('Genre 2');
    expect(appended[0].trackNumber).assertEqual(3);
  };

export default runExpansionCase;
