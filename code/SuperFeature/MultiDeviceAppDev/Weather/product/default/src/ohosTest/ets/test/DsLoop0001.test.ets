// @volume rule=datasource-loop basis=main-frozen cases=1
// Generated by scripts/gen_volume_cases.js. Hand-written anchor cases must be added
// to the same describe and marked with an @tc.desc starting with 'Anchor:'.
import { describe, it, expect, TestType, Size, Level } from '@ohos/hypium'
import { hilog } from '@kit.PerformanceAnalysisKit'
import { runDs } from '../util/TestHelper'
const LOG_DOMAIN: number = 0xF811
const LOG_TAG: string = '[Sample_Weather]'

export default function dsLoop0001Test() {
  describe('DsLoop0001', () => {

    /**
     * @tc.name   testDs0187
     * @tc.number SUB_WEATHER_DS_0187
     * @tc.desc   Anchor: runDs total/push/oob invariants over n=16..40
     * @tc.type   FUNCTION
     * @tc.size   MEDIUMTEST
     * @tc.level  LEVEL2
     */
    it('testDs0187', TestType.FUNCTION | Size.MEDIUMTEST | Level.LEVEL2, () => {
      hilog.info(LOG_DOMAIN, LOG_TAG, '%{public}s', 'testDs0187 begin')
      for (let n: number = 16; n <= 40; n++) {
        hilog.info(LOG_DOMAIN, LOG_TAG, 'actual=%{public}s expected=%{public}s', String(runDs(n, 'total')), String(String(n)))
        expect(runDs(n, 'total')).assertEqual(String(n))
        hilog.info(LOG_DOMAIN, LOG_TAG, 'actual=%{public}s expected=%{public}s', String(runDs(n, 'push')), String(String(n + 1) + "|new"))
        expect(runDs(n, 'push')).assertEqual(String(n + 1) + "|new")
        hilog.info(LOG_DOMAIN, LOG_TAG, 'actual=%{public}s expected=%{public}s', String(runDs(n, 'oob')), String('undefined'))
        expect(runDs(n, 'oob')).assertEqual('undefined')
      }
      hilog.info(LOG_DOMAIN, LOG_TAG, '%{public}s', 'testDs0187 end')
    })

  })
}
