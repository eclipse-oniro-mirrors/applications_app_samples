     * @tc.level  LEVEL1
     */
    it('testMock0075', TestType.FUNCTION | Size.MEDIUMTEST | Level.LEVEL1, () => {
      hilog.info(LOG_DOMAIN, LOG_TAG, '%{public}s', 'testMock0075 begin')
      const result: string = runMockDay(4, 6)
      hilog.info(LOG_DOMAIN, LOG_TAG, 'actual=%{public}s expected=%{public}s', String(result),
        String("29日（星期三）|2022-06-29|星期三|晴|sunny|35|39|26|31|优|05:00|19:04|<3级"))
      expect(result).assertEqual("29日（星期三）|2022-06-29|星期三|晴|sunny|35|39|26|31|优|05:00|19:04|<3级")
      hilog.info(LOG_DOMAIN, LOG_TAG, 'value=%{public}s', String(result.split('|').length === 13))
      expect(result.split('|').length === 13).assertTrue()
