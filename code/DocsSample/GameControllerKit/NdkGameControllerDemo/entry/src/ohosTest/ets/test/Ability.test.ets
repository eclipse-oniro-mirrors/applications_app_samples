import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
import { describe, it, expect } from '@ohos/hypium';
import { Driver, ON, MatchPattern, Component } from '@ohos.UiTest';
import { hilog } from '@kit.PerformanceAnalysisKit';

const TAG = '[Sample_GameControllerDemo]';
const DOMAIN = 0xF811;
const BUNDLE = 'GameControllerDemo';
const BUNDLE_NAME = 'com.example.ndkgamecontrollerdemo';
const ABILITY_NAME = 'EntryAbility';
const REGISTER_BUTTON_ID = 'register_button';
const QUERY_BUTTON_ID = 'query_button';
const CLEAR_BUTTON_ID = 'clear_button';
// The button labels are localized, so the labels of all supported locales are listed.
const REGISTER_LABELS: string[] = ['Register all event monitors', '注册全部事件监听'];
const UNREGISTER_LABELS: string[] = ['Unregister all event monitors', '取消注册全部事件监听'];
// The log messages are generated by the native layer in English, regardless of the system language.
const REGISTER_LOG_MARK = 'RightThumbstick_RegisterAxisInputMonitor';
const UNREGISTER_LOG_MARK = 'UnregisterDeviceMonitor Success';
const LOG_QUERY_MARK = 'GetAllDeviceInfos Success, the count is ';
const DELAY_MS = 3000;

/**
 * Obtains the current label of the toggle button by its id, which is not affected by the system language.
 */
async function getToggleLabel(driver: Driver): Promise<string> {
  let toggle = await driver.findComponent(ON.id(REGISTER_BUTTON_ID));
  return await toggle.getText();
}

/**
 * Makes sure all event monitors are registered. If the toggle button shows a register label,
 * clicks it once.
 */
async function ensureRegistered(driver: Driver): Promise<void> {
  let label = await getToggleLabel(driver);
  if (REGISTER_LABELS.indexOf(label) >= 0) {
    let toggle = await driver.findComponent(ON.id(REGISTER_BUTTON_ID));
    await toggle.click();
    await driver.delayMs(DELAY_MS);
  }
}

/**
 * Makes sure all event monitors are unregistered. If the toggle button shows an unregister label,
 * clicks it once.
 */
async function ensureUnregistered(driver: Driver): Promise<void> {
  let label = await getToggleLabel(driver);
  if (UNREGISTER_LABELS.indexOf(label) >= 0) {
    let toggle = await driver.findComponent(ON.id(REGISTER_BUTTON_ID));
    await toggle.click();
    await driver.delayMs(DELAY_MS);
  }
}

/**
 * Clears the log page so that the log assertions are not affected by the logs of previous cases.
 */
async function clearLogPage(driver: Driver): Promise<void> {
  let clearButton = await driver.findComponent(ON.id(CLEAR_BUTTON_ID));
  await clearButton.click();
  await driver.delayMs(DELAY_MS);
}

export default function abilityTest() {
  describe('ActsAbilityTest', () => {

    /**
     * Launch the app and check that the function buttons exist.
     */
    it(BUNDLE + '_StartAbility_001', 0, async (done: Function) => {
      hilog.info(DOMAIN, TAG, BUNDLE + '_StartAbility_001, begin');
      let driver = Driver.create();
      let abilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator();
      try {
        await abilityDelegator.startAbility({
          bundleName: BUNDLE_NAME,
          abilityName: ABILITY_NAME
        });
      } catch (exception) {
        hilog.info(DOMAIN, TAG, BUNDLE + `_StartAbility_001 exception = ${JSON.stringify(exception)}`);
        expect().assertFail();
      }
      await driver.delayMs(DELAY_MS);
      // The function buttons are found by id, which is not affected by the system language.
      hilog.info(DOMAIN, TAG, BUNDLE + '_StartAbility_001, check register button');
      await driver.assertComponentExist(ON.id(REGISTER_BUTTON_ID));
      hilog.info(DOMAIN, TAG, BUNDLE + '_StartAbility_001, check query button');
      await driver.assertComponentExist(ON.id(QUERY_BUTTON_ID));
      hilog.info(DOMAIN, TAG, BUNDLE + '_StartAbility_001, check clear button');
      await driver.assertComponentExist(ON.id(CLEAR_BUTTON_ID));
      done();
      hilog.info(DOMAIN, TAG, BUNDLE + '_StartAbility_001, end');
    })

    /**
     * Click the toggle button in the unregistered state. The button label changes to the
     * unregister one and the device monitor registration result is written to the log page.
     */
    it(BUNDLE + '_registerAllEventMonitors_001', 0, async (done: Function) => {
      hilog.info(DOMAIN, TAG, BUNDLE + '_registerAllEventMonitors_001, begin');
      let driver = Driver.create();
      let abilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator();
      try {
        await abilityDelegator.startAbility({
          bundleName: BUNDLE_NAME,
          abilityName: ABILITY_NAME
        });
      } catch (exception) {
        hilog.info(DOMAIN, TAG,
          BUNDLE + `_registerAllEventMonitors_001 exception = ${JSON.stringify(exception)}`);
        expect().assertFail();
      }
      await driver.delayMs(DELAY_MS);
      await clearLogPage(driver);
      await ensureUnregistered(driver);
      hilog.info(DOMAIN, TAG, BUNDLE + '_registerAllEventMonitors_001, click register button');
      let button = await driver.findComponent(ON.id(REGISTER_BUTTON_ID));
      await button.click();
      await driver.delayMs(DELAY_MS);

      // The log page shows the device monitor registration result generated by the native layer.
      hilog.info(DOMAIN, TAG, BUNDLE + '_registerAllEventMonitors_001, check register result log');
      await driver.assertComponentExist(ON.text(REGISTER_LOG_MARK, MatchPattern.CONTAINS));

      // The toggle button shows an unregister label after registering.
      hilog.info(DOMAIN, TAG, BUNDLE + '_registerAllEventMonitors_001, check toggle label');
      let label = await getToggleLabel(driver);
      expect(UNREGISTER_LABELS.indexOf(label) >= 0).assertTrue();
      done();
      hilog.info(DOMAIN, TAG, BUNDLE + '_registerAllEventMonitors_001, end');
    })

    /**
     * Click the toggle button in the registered state. The button label changes back to the
     * register one and the device monitor unregistration result is written to the log page.
     */
    it(BUNDLE + '_unregisterAllEventMonitors_001', 0, async (done: Function) => {
      hilog.info(DOMAIN, TAG, BUNDLE + '_unregisterAllEventMonitors_001, begin');
      let driver = Driver.create();
      let abilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator();
      try {
        await abilityDelegator.startAbility({
          bundleName: BUNDLE_NAME,
          abilityName: ABILITY_NAME
        });
      } catch (exception) {
        hilog.info(DOMAIN, TAG,
          BUNDLE + `_unregisterAllEventMonitors_001 exception = ${JSON.stringify(exception)}`);
        expect().assertFail();
      }
      await driver.delayMs(DELAY_MS);
      await clearLogPage(driver);
      await ensureRegistered(driver);
      hilog.info(DOMAIN, TAG, BUNDLE + '_unregisterAllEventMonitors_001, click unregister button');
      let button = await driver.findComponent(ON.id(REGISTER_BUTTON_ID));
      await button.click();
      await driver.delayMs(DELAY_MS);
      // The log page shows the device monitor unregistration result generated by the native layer.
      hilog.info(DOMAIN, TAG, BUNDLE + '_unregisterAllEventMonitors_001, check unregister result log');
      await driver.assertComponentExist(ON.text(UNREGISTER_LOG_MARK, MatchPattern.CONTAINS));
      // The toggle button shows a register label after unregistering.
      hilog.info(DOMAIN, TAG, BUNDLE + '_unregisterAllEventMonitors_001, check toggle label');
      let label = await getToggleLabel(driver);
      expect(REGISTER_LABELS.indexOf(label) >= 0).assertTrue();
      done();
      hilog.info(DOMAIN, TAG, BUNDLE + '_unregisterAllEventMonitors_001, end');
    })

    /**
     * Click the query button. The log page shows the device count, which is 0
     * when no game controller is connected.
     */
    it(BUNDLE + '_queryAllDeviceInfos_001', 0, async (done: Function) => {
      hilog.info(DOMAIN, TAG, BUNDLE + '_queryAllDeviceInfos_001, begin');
      let driver = Driver.create();
      let abilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator();
      try {
        await abilityDelegator.startAbility({
          bundleName: BUNDLE_NAME,
          abilityName: ABILITY_NAME
        });
      } catch (exception) {
        hilog.info(DOMAIN, TAG,
          BUNDLE + `_queryAllDeviceInfos_001 exception = ${JSON.stringify(exception)}`);
        expect().assertFail();
      }
      await driver.delayMs(DELAY_MS);
      hilog.info(DOMAIN, TAG, BUNDLE + '_queryAllDeviceInfos_001, click query button');
      let button = await driver.findComponent(ON.id(QUERY_BUTTON_ID));
      await button.click();
      await driver.delayMs(DELAY_MS);
      // The log page shows the query result with the device count.
      hilog.info(DOMAIN, TAG, BUNDLE + '_queryAllDeviceInfos_001, check query result log');
      await driver.assertComponentExist(ON.text(LOG_QUERY_MARK, MatchPattern.CONTAINS));
      done();
      hilog.info(DOMAIN, TAG, BUNDLE + '_queryAllDeviceInfos_001, end');
    })

    /**
     * Click the clear log button. The log page is cleared and no query result
     * remains, and the log page keeps receiving new logs after clearing.
     */
    it(BUNDLE + '_clearLog_001', 0, async (done: Function) => {
      hilog.info(DOMAIN, TAG, BUNDLE + '_clearLog_001, begin');
      let driver = Driver.create();
      let abilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator();
      try {
        await abilityDelegator.startAbility({
          bundleName: BUNDLE_NAME,
          abilityName: ABILITY_NAME
        });
      } catch (exception) {
        hilog.info(DOMAIN, TAG, BUNDLE + `_clearLog_001 exception = ${JSON.stringify(exception)}`);
        expect().assertFail();
      }
      await driver.delayMs(DELAY_MS);
      hilog.info(DOMAIN, TAG, BUNDLE + '_clearLog_001, click query button');
      let queryButton = await driver.findComponent(ON.id(QUERY_BUTTON_ID));
      await queryButton.click();
      await driver.delayMs(DELAY_MS);
      // The log page shows the query result before clearing.
      hilog.info(DOMAIN, TAG, BUNDLE + '_clearLog_001, check query result log');
      await driver.assertComponentExist(ON.text(LOG_QUERY_MARK, MatchPattern.CONTAINS));
      hilog.info(DOMAIN, TAG, BUNDLE + '_clearLog_001, click clear button');
      let clearButton = await driver.findComponent(ON.id(CLEAR_BUTTON_ID));
      await clearButton.click();
      await driver.delayMs(DELAY_MS);
      // The log page is empty after clearing.
      hilog.info(DOMAIN, TAG, BUNDLE + '_clearLog_001, check log page empty');
      let logComponent: Component | undefined = undefined;
      try {
        logComponent = await driver.findComponent(ON.text(LOG_QUERY_MARK, MatchPattern.CONTAINS));
      } catch (exception) {
        hilog.info(DOMAIN, TAG, BUNDLE + `_clearLog_001, log component not found = ${JSON.stringify(exception)}`);
      }
      expect(logComponent === undefined || logComponent == null).assertTrue();

      // The log page keeps receiving new logs after clearing.
      hilog.info(DOMAIN, TAG, BUNDLE + '_clearLog_001, click query button again');
      let queryAgainButton = await driver.findComponent(ON.id(QUERY_BUTTON_ID));
      await queryAgainButton.click();
      await driver.delayMs(DELAY_MS);
      hilog.info(DOMAIN, TAG, BUNDLE + '_clearLog_001, check new query result log');
      await driver.assertComponentExist(ON.text(LOG_QUERY_MARK, MatchPattern.CONTAINS));
      done();
      hilog.info(DOMAIN, TAG, BUNDLE + '_clearLog_001, end');
    })

  })
}
