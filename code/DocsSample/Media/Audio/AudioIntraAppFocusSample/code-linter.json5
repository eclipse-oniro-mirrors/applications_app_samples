{
  "files": [
    "**/*.ets",
    "**/*.ts",
    "**/*.js"
  ],
  "ignore": [],
  "ruleSet": [
    "no-unused-variable",
    "no-implicit-return-type",
    "no-explicit-any",
    "no-this-alias",
    "no-untyped-public-signature",
    "no-unsafe-declaration-merging",
    "no-unsafe-function-argument",
    "no-unsafe-assignment",
    "no-unsafe-return",
    "no-unsafe-call",
    "no-unsafe-member-access",
    "no-unsafe-enum-comparison",
    "no-empty-interface",
    "no-redundant-type-assertion",
    "no-return-await",
    "no-unnecessary-qualifier",
    "no-sparse-arrays"
  ],
  "defects": [
    "CWE-20",
    "CWE-22",
    "CWE-78",
    "CWE-89",
    "CWE-90",
    "CWE-94",
    "CWE-113",
    "CWE-116",
    "CWE-134",
    "CWE-190",
    "CWE-191",
    "CWE-193",
    "CWE-197",
    "CWE-200",
    "CWE-209",
    "CWE-215",
    "CWE-254",
    "CWE-319",
    "CWE-327",
    "CWE-362",
    "CWE-400",
    "CWE-476",
    "CWE-502",
    "CWE-733"
  ],
  "complexity": [
    "no-func-length",
    "no-cognitive-complexity",
    "no-nested-switch",
    "no-nested-conditional",
    "no-nested-template-literals",
    "no-multi-line-logical-expression",
    "no-misused-promises",
    "no-hungarian-notation",
    "no-duplicate-string",
    "no-duplicate-imports",
    "no-deprecated-decorator",
    "no-consecutive-overloads",
    "no-commonjs-imports",
    "no-commonjs-exports",
    "no-banned-words",
    "no-array-constructor"
  ],
  "security": [
    "no-xss",
    "no-unsafe-regex",
    "no-hardcoded-credentials",
    "no-duplicate-json-keys"
  ]
}
