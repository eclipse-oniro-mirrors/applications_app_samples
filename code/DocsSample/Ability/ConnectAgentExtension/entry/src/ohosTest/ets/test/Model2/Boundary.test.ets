import { describe, beforeAll, afterAll, it, expect } from '@ohos/hypium';
import { hilog } from '@kit.PerformanceAnalysisKit';
import {
  AGENT_BUNDLE, AGENT_ABILITY, AGENT_ID, AGENT_ID_MAX_LENGTH, PAYLOAD_MAX_LENGTH, STATE_IDLE, STATE_CONNECTING, STATE_CONNECTED, STATE_DISCONNECTED, EVENT_DATA, EVENT_AUTH, EVENT_DISCONNECT, ERROR_SUCCESS, ERROR_INVALID_PARAM, ERROR_NOT_CONNECTED, ERROR_AUTH_FAILED, ERROR_PROXY_RELEASED, AgentModel, AgentWant, AgentEvent
} from '../Shared/AgentFixtures';

const DOMAIN: number = 0xF811;
const TAG: string = '[Sample_AgentManager]';

export default function connectAgentExtensionBoundaryTest(): void {
  describe('ConnectAgentExtensionModelTestBoundary', (): void => {
    beforeAll((): void => {
      hilog.info(DOMAIN, TAG, '%{public}s', 'connectAgentExtensionBoundaryTest started');
    });
    afterAll((): void => {
      hilog.info(DOMAIN, TAG, '%{public}s', 'connectAgentExtensionBoundaryTest finished');
    });

    // @tc.number    SUB_AGENT_EXTENSION_BOUNDARY_0001
    // @tc.name      connectAgentExtensionBoundaryCase001
    // @tc.desc      Verify agent id length boundary at 0. (parameterised matrix part 1).
    it('connectAgentExtensionBoundaryCase001', 0, (): void => {
      {
        const agentId: string = '';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertFalse();
      }
      {
        const agentId: string = 'a';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertTrue();
      }
      {
        const agentId: string = 'aa';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertTrue();
      }
      {
        const agentId: string = 'aaa';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertTrue();
      }
      {
        const agentId: string = 'aaaa';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertTrue();
      }
      {
        const agentId: string = 'aaaaa';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertTrue();
      }
      {
        const agentId: string = 'aaaaaa';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertTrue();
      }
      {
        const agentId: string = 'aaaaaaa';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertTrue();
      }
      {
        const agentId: string = 'aaaaaaaaaaaaaaaa';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertTrue();
      }
      {
        const agentId: string = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertTrue();
      }
    });

    // @tc.number    SUB_AGENT_EXTENSION_BOUNDARY_0002
    // @tc.name      connectAgentExtensionBoundaryCase002
    // @tc.desc      Verify agent id length boundary at 63. (parameterised matrix part 2).
    it('connectAgentExtensionBoundaryCase002', 0, (): void => {
      {
        const agentId: string = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertTrue();
      }
      {
        const agentId: string = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertTrue();
      }
      {
        const agentId: string = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertFalse();
      }
      {
        const agentId: string = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertFalse();
      }
      {
        const agentId: string = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
        const result: boolean = AgentModel.isValidAgentId(agentId);
        expect(result).assertFalse();
      }
      {
        const payload: string = '';
        const result: boolean = AgentModel.isValidPayload(payload);
        expect(result).assertFalse();
      }
      {
        const payload: string = 'a';
        const result: boolean = AgentModel.isValidPayload(payload);
        expect(result).assertTrue();
      }
      {
        const payload: string = 'aa';
        const result: boolean = AgentModel.isValidPayload(payload);
        expect(result).assertTrue();
      }
      {
        const payload: string = '';
        const result: boolean = AgentModel.isValidPayload(payload);
        expect(result).assertTrue();
      }
      {
        const payload: string = '';
        const result: boolean = AgentModel.isValidPayload(payload);
        expect(result).assertTrue();
      }
    });

    // @tc.number    SUB_AGENT_EXTENSION_BOUNDARY_0003
    // @tc.name      connectAgentExtensionBoundaryCase003
    // @tc.desc      Verify payload length boundary at 4097. (parameterised matrix part 3).
    it('connectAgentExtensionBoundaryCase003', 0, (): void => {
      {
        const payload: string = '';
        const result: boolean = AgentModel.isValidPayload(payload);
        expect(result).assertFalse();
      }
      {
        const payload: string = '';
        const result: boolean = AgentModel.isValidPayload(payload);
        expect(result).assertFalse();
      }
      {
        const agentId: string = '';
        const result: number = AgentModel.agentIdLength(agentId);
        expect(result).assertEqual(0);
      }
      {
        const agentId: string = 'a';
        const result: number = AgentModel.agentIdLength(agentId);
        expect(result).assertEqual(1);
      }
      {
        const agentId: string = 'aa';
        const result: number = AgentModel.agentIdLength(agentId);
        expect(result).assertEqual(2);
      }
      {
        const agentId: string = 'aaa';
        const result: number = AgentModel.agentIdLength(agentId);
        expect(result).assertEqual(3);
      }
      {
        const agentId: string = 'aaaa';
        const result: number = AgentModel.agentIdLength(agentId);
        expect(result).assertEqual(4);
      }
      {
        const agentId: string = 'aaaaa';
        const result: number = AgentModel.agentIdLength(agentId);
        expect(result).assertEqual(5);
      }
      {
        const agentId: string = 'aaaaaa';
        const result: number = AgentModel.agentIdLength(agentId);
        expect(result).assertEqual(6);
      }
      {
        const agentId: string = 'aaaaaaa';
        const result: number = AgentModel.agentIdLength(agentId);
        expect(result).assertEqual(7);
      }
    });

    // @tc.number    SUB_AGENT_EXTENSION_BOUNDARY_0004
    // @tc.name      connectAgentExtensionBoundaryCase004
    // @tc.desc      Verify agentIdLength for length slot 8. (parameterised matrix part 4).
    it('connectAgentExtensionBoundaryCase004', 0, (): void => {
      {
        const agentId: string = 'aaaaaaaa';
        const result: number = AgentModel.agentIdLength(agentId);
        expect(result).assertEqual(8);
      }
      {
        const agentId: string = 'aaaaaaaaa';
        const result: number = AgentModel.agentIdLength(agentId);
        expect(result).assertEqual(9);
      }
      {
        const agentId: string = 'aaaaaaaaaa';
        const result: number = AgentModel.agentIdLength(agentId);
        expect(result).assertEqual(10);
      }
      {
        const agentId: string = 'aaaaaaaaaaa';
        const result: number = AgentModel.agentIdLength(agentId);
        expect(result).assertEqual(11);
      }
    });

  });
}
