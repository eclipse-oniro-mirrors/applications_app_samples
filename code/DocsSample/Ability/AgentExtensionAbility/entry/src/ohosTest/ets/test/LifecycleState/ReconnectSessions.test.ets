    it('orderedBatch_separators_units128_batch1_013', 0, () => {
      const fixture = new AgentCallbackFixture();
      const input: string = repeatedPayload("|:;,=[]{}/\\!?@#$%^&*()", 128);
      fixture.connect();
      try {
