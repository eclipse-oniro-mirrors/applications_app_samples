import { expect } from '@ohos/hypium';
import { ContinuousFixture, model, drain } from './ContinuousFixture';

/**
 * @tc.number EXP_CT_PLAY_CONTROL_003
 * @tc.name 真实播放暂停停止门控、Promise顺序及状态缺陷 CT_PLAY_CONTROL_003
 * @tc.desc Catalog oracle: {"playerPlayCalls":0,"createSessionCalls":0,"isPlayingUnchanged":true}
 * @tc.level Level 1
 */
const runExpansionCase: () => Promise<void> = async (): Promise<void> => {
    const f = await ContinuousFixture.open();
    let primaryFailed: boolean = false;
    try {
      model.playMusic(1, false, f.context);
      await drain();
      expect(f.calls.length).assertEqual(0);
      expect(model.isPlaying).assertFalse();
    } catch (error) {
      primaryFailed = true;
      throw error as Error;
    } finally {
      await f.close(primaryFailed);
    }
  };

export default runExpansionCase;
